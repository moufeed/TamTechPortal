@model TamTechSDK.Common.Services.Identity.Auth.Models.ChangePassword;


@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";


}



 





<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="200" />

    </header>



    @if (TempData["showMessage"] == null)
    {
        @Html.Partial("_ValidationSummary")
        <div class="form-wrap">
            <form class="form " method="post" asp-action="changePassword" id="resetpassword">

                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="CurrentPassword" placeholder="Current Password" autofocus required>
                </div>
                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="NewPassword" placeholder="new password" required>
                </div>
                <div class="form-group">
                    <input class="form-control input-lg" type="password" name="ConfirmPassword" id="ConfirmPassword" placeholder="Confirm new Password" required>
                </div>
                <div class="form-group">
                    <button class="btn btn-login btn-block btn-lg" name="button" value="Reset">Change Password</button>
                </div>
                <div class="form-group">
                    <a href="@Url.Action("index", "home",new { area = "admin"})" class="btn-link">Back To dashboard</a>
                    <a asp-area="identity" asp-action="Logout" asp-controller="Account" class="pull-right btn-link">
                         Log out
                    </a>
                </div>

                 
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            Congratulations You've successfully changed your password .
            <a href="@Url.Action("index", "home",new { area = "admin"})" class="alert-link">Click here</a> to return Dashboard.

        </div>

    }



</div>







@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>

        $("#resetpassword").validate({
                errorClass: "invalid-feedback",
                validClass: "valid-feedback",
                rules: {
                    NewPassword: {
                        required: true,
                        minlength: 4
                    },
                    ConfirmPassword: {
                        equalTo: "#NewPassword"
                    }
                }
            });


    </script>


}