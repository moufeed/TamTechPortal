@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";
}
  
<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="200" />

    </header>


    @Html.Partial("_ValidationSummary")
    @if (TempData["email"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show in">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            Thanks! Please check  <strong> @TempData["email"]  </strong>for a link to reset your password.
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show in">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            @TempData["error"]
        </div>
    }

    <div class="form-wrap">

        <form class="form" method="post" asp-action="ForgottenPassword" >
            <div class="form-group">
                <label for="email" class="label c-black" style="color:#000000"> Email  Address</label>
                <input class="form-control input-lg" type="email" name="email" id="email" placeholder="Email Address" autofocus required>
            </div>
            <div class="form-group">
                <button class="btn btn-login btn-block btn-lg" name="button" value="Reset">Reset Password</button>
            </div>
            <div class="form-group">
                <a href="@Url.Action("login", "account")" class="btn-link">Back To Login</a>
                
            </div>
        </form>
    </div>
</div>


