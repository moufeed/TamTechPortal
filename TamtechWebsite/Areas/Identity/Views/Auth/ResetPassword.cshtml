@model TamTechSDK.Common.Services.Identity.Auth.Models.ResetPassword ;


@{
    ViewBag.bodyClass = "login_page";
    ViewBag.className = "login_conteiner";

 
}





<div class="login-wrap col-md-5">
    <header class="header_login text-center">
        <img src="~/Identity/img/logo.png" width="200" />
         
    </header>



    @if (TempData["showMessage"] == null)
    {
        @Html.Partial("_ValidationSummary")
        <div class="form-wrap">
            <form class="form " method="post" asp-action="ResetPassword" id="resetpassword">

                <input type="hidden" asp-for="Token" value="@ViewBag.Token" />
                <input type="hidden" asp-for="UserId" value="@ViewBag.UserId" />


                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="NewPassword" placeholder="password" autofocus required>
                </div>
                <div class="form-group">
                    <input class="form-control input-lg" type="password" asp-for="ConfirmPassword" id="ConfirmPassword" placeholder="Confirm Password" required>
                </div>
                <div class="form-group">
                    <button class="btn btn-login btn-block btn-lg" name="button" value="Reset">Reset Password</button>
                </div>
                <div class="form-group">
                    <a href="@Url.Action("login", "account")" class="btn-link">Back To Login</a>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            Your password has been reset <a href="@Url.Action("login", "account")" class="alert-link">Click here</a> to return login page.
        </div>
   
    }



</div>







@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
 
        $("#resetpassword").validate({
                errorClass: "invalid-feedback",
                validClass: "valid-feedback",
                rules: {
                    Password: {
                        required: true,
                        minlength: 4
                    },
                    ConfirmPassword: {
                        equalTo: "#NewPassword"
                    }
                }
            });


    </script>


}