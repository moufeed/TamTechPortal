@model UpdateSliderItemDto

@{
    ViewData["Title"] = "Silders - Edit Slide";
    ViewData["UnitTestPageClass"] = "ut-slides-edit";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}




<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["edit_slider_item"]<small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("Edit" ,"sliders" ,  new { id = ViewBag.SliderId , culture = activeLang })"
               class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_slider"]</a>
        </div>
    </div>
</div>



<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">

        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary {
                { "sliderId", ViewBag.SliderId} ,
                { "sliderTitle", ViewBag.SliderTitle},
                {"slideId" , Model.Id }
            };
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")


        <div class="x_panel">
            <div class="x_content">

              

                <form asp-controller="Sliders"
                      asp-action="EditItem"
                      method="post"
                      class="form-horizontal forn-new form-label-left m-t5"
                      id="SliderItemForm" enctype="multipart/form-data">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    }

                    <input type="hidden" name="sliderTitle" value="@ViewBag.SliderTitle" />
                    <input type="hidden" name="SliderId" value="@ViewBag.SliderId" />
                    <input type="hidden" name="Lang" value="@activeLang" />
                    <input type="hidden" name="Id" value="@Model.Id" />


                    <div class="form-group clearfix">
                        <label class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_slider_title"]</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">
                            <p class="form-control-static">@ViewBag.SliderTitle</p>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Title" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_title"]</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger invalid_field"></span>
                        </div>
                    </div>


                    <div class="form-group clearfix">
                        <label asp-for="MainImage" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_main_image"]</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">

                            @if (!string.IsNullOrEmpty(Model.MainImage))
                            {
                                <img src="@Model.MainImage" style="max-width:300px" class="img-thumbnail m-b3">
                                <input type="hidden" name="MainImage" value="@Model.MainImage" />
                            }

                            <label class="form-control clearfix uploadfile">
                                <input type="file" name="NewMainImage" id="NewMainImage" class="upload-input" data-text="@Localizer["choose_file"]" accept="image/*" />
                                <span class="url">@Localizer["choose_file"]</span>
                                <span class="file-btn"><i class="fa fa-search"></i> @Localizer["Browse"]</span>
                            </label>
                            <label id="NewMainImage-error" class="error invalid_field" for="NewMainImage" style="display:none;"></label>
                            <span asp-validation-for="MainImage" class="text-danger invalid_field"></span>

                        </div>
                    </div>





                    <div class="form-group clearfix">
                        <label asp-for="Url" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_url"]</label>
                        <div class="col-md-5 col-sm-3 col-xs-12">
                            <input asp-for="Url" class="form-control" />
                            <span asp-validation-for="Url" class="text-danger invalid_field"></span>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-12">
                            <select class="form-control" asp-for="UrlTarget" id="UrlTarget">
                                <option value="_blank">_blank</option>
                                <option value="_self">_self</option>
                                <option value="_parent">_parent</option>
                                <option value="_top">_top</option>
                            </select>
                        </div>
                    </div>




                    <div class="form-group clearfix">
                        <label asp-for="DisplayOrder" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_display_order"]</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">
                            <input asp-for="DisplayOrder" class="form-control" min="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger invalid_field"></span>
                        </div>
                    </div>



                    <div class="form-group clearfix">
                        <label asp-for="Summary" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_summary"]</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">
                            <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Summary" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-6 col-md-offset-3 col-sm-offset-4 col-sm-6 col-xs-12 ">
                            <input type="submit" class="btn btn-success p-x-5 ut-save-btn" value="@Localizer["save"]">
                            <button type="submit" name="save-continue" class="btn  btn-info ut-continue-btn">
                                <i class="fa fa-floppy-o"></i>
                                @Localizer["save_and_continue"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>






@section Styles{

}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }


    <script>




         $('#SliderItemForm').validate({
            errorClass: "invalid_field",
            validClass: "valid_field",
            ignore: ".ignore"
        });
    </script>


    @{
        ViewBag.TinyMce_Contetnt_Id = null;
        ViewBag.TinyMce_Suumry_Id = "#Summary";
        await Html.RenderPartialAsync("partials/_tinymce.cshtml");
    }
 
}


