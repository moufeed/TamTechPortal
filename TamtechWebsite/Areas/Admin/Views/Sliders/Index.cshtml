@model List<SliderDto>
@{
    ViewData["Title"] = Localizer["Sliders"];
    ViewData["UnitTestPageClass"] = "ut-sliders-index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}
<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["Sliders"] <small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("CreateSlider" ,"Sliders")"
               class="btn btn-blue btn-add-new ut-new-btn">@Localizer["new_slider"]</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary {  };
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")

        
        <div class="x_panel p-x-0">


            <div class="x_content">
                <div class="table-responsive">
                    <table class="table table-middle table-striped sliders-table" id="SlidersTable">
                        <thead>
                            <tr>
                                <th class="index" style="min-width:150px">@Localizer["t_title"]</th>
                                <th style="min-width:100px">@Localizer["t_key"]</th>
                                <th style="min-width:200px">@Localizer["t_summary"]</th>
                                <th width="75" class="text-center">@Localizer["t_visibility"]</th>
                                <th width="175">@Localizer["t_actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr id="tr-@item.Id">
                                    <td class="index"> @item.Title  </td>
                                    <td>@item.Key</td>
                                    <td>
                                        @{
                                            string text;
                                            if (item.Summary != null)
                                            {
                                                text = Regex.Replace(item.Summary, "<.*?>", String.Empty);
                                            }
                                        }

                                        @Html.Raw(item.Summary)
                                    </td>
                                    <td class="text-center">


                                        @if (item.Locked)
                                        {
                                             <if include-if="item.Published">
                                                <span class="label label-success">
                                                    <i class="fa fa-eye "></i>
                                                    @Localizer["t_published"]
                                                </span>
                                            </if>
                                            <if exclude-if="item.Published">
                                                <span class="label label-danger">
                                                    <i class="fa fa-eye-slash "></i>
                                                    @Localizer["t_unpublished"]
                                                </span>
                                            </if>
                                        }
                                        else
                                        {
                                            @if (item.Published)
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-status="true"
                                                   title="@Localizer["t_unpublish"]"
                                                   data-type="slider"
                                                   data-url="@Url.AdminUrl("PublishSliderAsync","Sliders" ,new { id= item.Id })"
                                                   class="btn btn-link-pup published toggle__publish ut-published">
                                                    <i class="fa fa-eye c-green"></i>
                                                    <small>@Localizer["t_published"]</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-status="true"
                                                   title="@Localizer["t_publish"]"
                                                   data-type="slider"
                                                   data-url="@Url.AdminUrl("PublishSliderAsync","Sliders" ,new { id= item.Id })"
                                                   class="btn btn-link-pup unpublished toggle__publish ut-unpublished">
                                                    <i class="fa fa-eye-slash c-red"></i>
                                                    <small>@Localizer["t_unpublished"]</small>
                                                </a>
                                            }
                                        }
                                    </td>



                                    <td>
                                        <div>
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_details"]"
                                               href="@Url.AdminUrl("details","sliders",new { id=item.Id} )"
                                               class="btn btn-view btn-round"><i class="fa fa-info "></i></a>
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               href="@Url.AdminUrl("Edit","sliders",new { id=item.Id})"
                                               title="@Localizer["t_edit"]"
                                               class="btn btn-edit btn-round ut-edit-btn"><i class="fa fa-edit "></i></a>
                                            <if include-if="item.Locked">
                                                <span data-toggle="tooltip"
                                                     data-placement="@(activeLang == "ar" ? "right" : "left")"
                                                      class="btn-locked btn-round"
                                                      title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                            </if>
                                            <if exclude-if="item.Locked">
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   title="@Localizer["t_remove"]"
                                                   data-url="@Url.AdminUrl("DeleteAsync","sliders",new { id=item.Id})"
                                                   data-target="#tr-@item.Id"
                                                   data-id="@item.Id"
                                                   class="btn btn-remove btn-round delete__slider ut-delete-btn"><i class="fa fa-trash-o"></i></a>
                                            </if>
                                            
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles{
}
@section Scripts {
    <script src="~/Admin/js/sliders.min.js"></script>
}