@model List<ServiceDto>
@{
    ViewData["Title"] = Localizer["services"];
    ViewData["UnitTestPageClass"] = "ut-sevices_index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);

}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3> @Localizer["services"] <small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("Create", "services")"
               class="btn btn-blue btn-add-new ut-create_btn">@Localizer["new_service"]</a>

        </div>
    </div>
</div>



<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">


        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")


        <div class="x_panel p-x-0">



            <div class="x_content">
                <partial name="_Filters.cshtml" model="ViewBag.FilterModel" />
                <div class="table-responsive">
                    <table class="table table-middle table-striped services-table" id="ServicesTable">
                        <thead>
                        <th width="100" class="text-center">@Localizer["t_image"]</th>
                        <th>@Localizer["t_title"]</th>

                        <th>@Localizer["t_summary"]</th>

                        <th width="100" class="text-center">@Localizer["t_visibility"]</th>
                        <th width="175">@Localizer["t_actions"]</th>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr id="tr-@item.Id">
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.MainImage))
                                        {

                                            <img src="@item.MainImage" alt="" width="60" />
                                        }
                                        else
                                        {
                                            <img src="~/Admin/img/noimage.jpg" alt="" width="75" />
                                        }
                                    </td>
                                    <td style="min-width:150px">
                                        @if (item.Published)
                                        {

                                            <a asp-area="Portal" asp-action="v" asp-controller="services" asp-route-slug="@item.Slug" target="_blank" class="underline ser-title">
                                                @item.Title
                                            </a>
                                        }
                                        else
                                        {
                                            <a target="_blank" data-href="@Url.AdminUrl("v", "services", new { area = "portal", slug = item.Slug })" class="ser-title"> @item.Title</a>
                                        }

                                    </td>


                                    <td>
                                        <div class="ser-summary">
                                            @{
                                                string text = "";
                                                if (!string.IsNullOrWhiteSpace(item.Summary))
                                                {
                                                    text = Regex.Replace(item.Summary, "<.*?>", String.Empty);
                                                }
                                            }
                                            @Html.Raw(text)
                                        </div>
                                    </td>

                                    <td class="text-center">

                                        @if (item.Locked)
                                        {
                                            <if include-if="item.Published">
                                                <span class="label label-success">
                                                    <i class="fa fa-eye "></i>
                                                    @Localizer["t_published"]
                                                </span>
                                            </if>
                                            <if exclude-if="item.Published">
                                                <span class="label label-danger">
                                                    <i class="fa fa-eye-slash "></i>
                                                    @Localizer["t_unpublished"]
                                                </span>
                                            </if>
                                        }
                                        else
                                        {
                                            @if (item.Published)
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-status="true"
                                                   data-url="@Url.AdminUrl("PublishAsync", "services", new { id = item.Id })"
                                                   title="@Localizer["t_unpublish"]"
                                                   data-unpublished="@Localizer["t_unpublished"]"
                                                   data-published="@Localizer["t_published"]"
                                                   class="btn btn-link-pup published ut-published toggle_publish">
                                                    <i class="fa fa-eye c-green"></i>
                                                    <small>@Localizer["t_published"]</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-url="@Url.AdminUrl("PublishAsync", "services", new { id = item.Id })"
                                                   title="@Localizer["t_publish"]"
                                                   data-unpublished="@Localizer["t_unpublished"]"
                                                   data-published="@Localizer["t_published"]"
                                                   class="btn btn-link-pup unpublished ut-unpublished toggle_publish">
                                                    <i class="fa fa-eye-slash c-red"></i>
                                                    <small>@Localizer["t_unpublished"]</small>
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_details"]"
                                               href="@Url.AdminUrl("Details", "services", new { id = item.Id })"
                                               class="btn btn-view btn-round ut-detail_btn"><i class="fa fa-info "></i></a>

                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_edit"]"
                                               href="@Url.AdminUrl("Edit", "services", new { id = item.Id })"
                                               class="btn btn-edit btn-round ut-edit_btn"><i class="fa fa-edit "></i></a>
                                            <if include-if="item.Locked">
                                                <span data-toggle="tooltip"
                                                      data-placement="@(activeLang == "ar" ? "left" : "right")"
                                                      class="btn-locked btn-round"
                                                      title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                            </if>
                                            <if exclude-if="item.Locked">
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-id="@item.Id"
                                                   data-url="@Url.AdminUrl("DeleteAsync", "services", new { id = item.Id })"
                                                   title="@Localizer["t_remove"]"
                                                   class="btn btn-remove btn-round delete-service ut-service_remove_btn"><i class="fa fa-trash-o "></i></a>
                                            </if>
                                        </div>

                                    </td>
                                </tr>

                            }

                            <if include-if='Model.Count == 0'>
                                <tr>
                                    <td colspan="5" class="text-center">
                                        <p class="empty_row">
                                            <i class='fa fa fa-exclamation-circle'></i>
                                            @Localizer["no_data_table"]
                                        </p>
                                    </td>
                                </tr>
                            </if>

                        </tbody>
                    </table>
                </div>
                <hr class="m-y-2" />
                <pagination controller-name="services" filter-model="ViewBag.FilterModel" pagniation-model="ViewBag.pagination" total="true"></pagination>

            </div>
        </div>
    </div>
</div>


@section Styles{
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}


@section Scripts {
    <script src="~/Admin/js/services.min.js"></script>
    <script src="~/Admin/lib/select2/dist/js/select2.js"></script>
    <script>
        $('.select_no-search').select2({ minimumResultsForSearch: -1});
    </script>
}