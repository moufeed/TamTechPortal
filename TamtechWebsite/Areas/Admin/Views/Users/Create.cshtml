
@{
    @using AdminPanelWeb.Models;
    @model CreateUserVM;
    ViewData["Title"] = Localizer["User_Create"];
    ViewData["UnitTestPageClass"] = "ut-Users_create";
    //   Layout = "~/Views/Shared/_Layout.cshtml";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}


<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["new_user"] </h3>
        </div>
        <div class="title_right">
            <a asp-action="Index" class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
        </div>
    </div>
</div>


<section class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary {};
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")
        <div class="x_panel">
            <div class="x_content">

                @using (Html.BeginForm("Create", "Users", FormMethod.Post,
                          new
                          {
                              enctype = "multipart/form-data",
                              @class = "form-horizontal forn-new form-label-left m-t5",
                              id = "EditUserForm"
                          }))

                {
                    @Html.ValidationSummary(true, "", new { @class = "  col-md-3 col-sm-4 col-xs-12 " })
                    @Html.HiddenFor(m => m.Id)

                    <div class="clearfix">
                        @*<div class="col-sm-4 col-xs-12 col-md-3">
                            <div class="imagebox">
                                <img src="" alt="" id="imagePreview">
                            </div>
                            <div class="form-group from-file">
                                <input type="file" name="ImageUrl" id="avater" class="input-file" accept="image/*">
                                <label for="avater" class="btn btn-tertiary  ">
                                    <span>Choose a Picture</span>
                                </label>
                            </div>
                        </div>*@

                        <div class="col-sm-8 col-xs-12 col-md-9">
                            @*<div class="form-group clearfix ">
                                @Html.Label("Name", "Name :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control ignore", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger  " })
                                </div>
                            </div>*@
                            <div class="form-group clearfix">

                                <label asp-for="UserName" class="control-label col-md-3 col-sm-4 col-xs-12 ">@Localizer["f_username"]</label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", required = "required", id = "ut-username" })
                                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            <div class="form-group clearfix">
                                <label asp-for="Email" class="control-label col-md-3 col-sm-4 col-xs-12 ">@Localizer["f_email"]</label>

                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "Email", id = "ut-email" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger  " })
                                </div>
                            </div>

                            <div class="form-group clearfix">

                                <label asp-for="Password" class="control-label col-md-3 col-sm-4 col-xs-12 ">@Localizer["f_password"]</label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.Password("Password", null, new { @class = "form-control", required = "required", id = "ut-password" })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger  " })

                                </div>
                            </div>

                            <div class="form-group clearfix">

                                <label asp-for="ConfirmPasswoord" class="control-label col-md-3 col-sm-4 col-xs-12 ">@Localizer["f_confirmpassword"]</label>

                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.Password("ConfirmPasswoord", null, new { @class = "form-control", required = "required", id = "ut-confirmpassword" })
                                    @Html.ValidationMessageFor(m => m.ConfirmPasswoord, "", new { @class = "text-danger  " })

                                </div>
                            </div>

                            <div class="form-group clearfix">

                                <label asp-for="PhoneNumber" class="control-label col-md-3 col-sm-4 col-xs-12 ">@Localizer["f_phone"]</label>

                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", @type = "tel", required = "required", id = "ut-phonenumber" })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            @*<div class="form-group ">

                                @Html.Label("Gender", "Gender :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="btn-group" data-toggle="buttons">
                                        <label class="btn btn-default">
                                            @Html.RadioButtonFor(m => m.Gender, "male") &nbsp; Male &nbsp;
                                        </label>
                                        <label class="btn btn-default">
                                            @Html.RadioButtonFor(m => m.Gender, "female") Female
                                        </label>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger  " })
                                </div>
                            </div>*@
                            <div class="form-group clearfix">

                                <label asp-for="Roles" class="control-label col-md-3 col-sm-4 col-xs-12 ">@Localizer["f_role"]</label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @{
                                        var bagRoles = (IEnumerable<RoleModel>)ViewBag.Roles;
                                        var roles = bagRoles.Select(r => new SelectListItem(r.Name, r.Name, (Model?.Roles != null) ? Model.Roles.Any(u => u == r.Name) : false)).ToList();
                                    }

                                    @Html.ListBox("Roles", roles, htmlAttributes: new { @class = "form-control select_picker", required = "required", id = "ut-role" })
                                <label id="ut-role-error" class="invalid_field" for="ut-role"></label>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-3 col-sm-offset-4 col-sm-6 col-xs-12 ">
                                    <input type="submit" class="btn btn-success p-x-5 ut-create_btn" value="@Localizer["create"]">
                                </div>
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>
</section>

@section Styles{
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="~/Admin/lib/select2/dist/js/select2.min.js"></script>

    <script>
        $('.select_picker').select2();

        $('#EditUserForm').validate({
            errorClass: "invalid_field",
            validClass: "valid_field",
            ignore: ".ignore"
        });

    </script>

    @if (ViewBag.status != null)
    {
        <script>
            $notification.success(@Localizer["success"], @Localizer["user_has_been_created"]);
        </script>
    }
    else if (ViewBag.hasError != null)
    {
        <script>
            $notification.error(@Localizer["error"], " ");
        </script>

    }

}
