 

@{
    @using AdminPanelWeb.Models;
    @model CreateUserVM;
    ViewData["Title"] = Localizer["user_edit"];
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["edit_user"]</h3>
        </div>
        <div class="title_right">
            <a asp-action="Index" class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
        </div>
    </div>
</div>

<section class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_content">


                <form asp-action="Edit"
                      asp-controller="Users"
                      method="post"
                      enctype="multipart/form-data"
                      class="form-horizontal forn-new form-label-left m-t5"
                      id="EditUserForm">

                    

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }

                    <input type="hidden" asp-for="Id" />

                    <div class="clearfix">
                        <div class="col-sm-4 col-xs-12 col-md-3">
                            <div class="imagebox">
                                <img src="" alt="" id="imagePreview">
                            </div>
                            <div class="form-group from-file">
                                <input type="file" name="ImageUrl" id="avater" class="input-file" accept="image/*">
                                <label for="avater" class="btn btn-tertiary  ">
                                    <span>@Localizer["choose_picture"]</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-sm-8 col-xs-12 col-md-9">
                            <div class="form-group clearfix ">

                                <label asp-for="Name" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_name"]<i class="fa fa-asterisk c-red fz-10 "></i></label>
                                <div class="col-md-7 col-sm-8 col-xs-12">                           
                                    <input asp-for="Name" class="form-control" required />
                                    <span asp-validation-for="Name" class="text-danger invalid_field"></span>
                                </div>
                            </div>
                            <div class="form-group clearfix">

                                <label asp-for="UserName" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_username"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    <input asp-for="UserName" class="form-control" required />
                                    <span asp-validation-for="UserName" class="text-danger invalid_field"></span>
                                </div>
                            </div>
                            <div class="form-group clearfix">

                                <label asp-for="Email" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_email"]</label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    <input  type="email" asp-for="Email" class="form-control"  />
                                    <span asp-validation-for="Email" class="text-danger invalid_field"></span>

                                </div>
                            </div>

                            <div class="form-group clearfix">

                                <label asp-for="Password" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_password"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    <input type="password" asp-for="Password" class="form-control" required/>
                                    <span asp-validation-for="Password" class="text-danger invalid_field"></span>
                                </div>
                            </div>

                            <div class="form-group clearfix">

                                <label asp-for="ConfirmPasswoord" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_confirmpassword"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    <input type="password" asp-for="ConfirmPasswoord" class="form-control" required />
                                    <span asp-validation-for="ConfirmPasswoord" class="text-danger invalid_field"></span>
                                </div>
                            </div>

                            <div class="form-group clearfix">

                                <label asp-for="PhoneNumber" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_phone"]<i class="fa fa-asterisk c-red fz-10 "></i></label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    <input type="tel" asp-for="PhoneNumber" class="form-control" required />
                                    <span asp-validation-for="PhoneNumber" class="text-danger invalid_field"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Gender" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_gender"]</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="btn-group" data-toggle="buttons">
                                        <label class="btn btn-default">
                                            <input type="radio" asp-for="Gender" value="male" /> &nbsp; Male &nbsp;
                                        </label>
                                        <label class="btn btn-default">
                                            <input type="radio" asp-for="Gender" value="female" /> Female
                                        </label>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            <div class="form-group clearfix">

                                <label asp-for="Roles" class="control-label col-md-3 col-sm-4 col-xs-12">@Localizer["f_role"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                                <div class="col-md-7 col-sm-8 col-xs-12">
 
                                    @Html.DropDownList("Roles",
                                   new SelectList(ViewBag.Roles,"Name", "Name"),
                                       "Select Role",
                                       htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Roles, "", new { @class = "text-danger  ", required = "required" })
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-3 col-sm-offset-4 col-sm-6 col-xs-12 ">
                                    <input type="submit" class="btn btn-success p-x-5" value="@Localizer["create"]">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
