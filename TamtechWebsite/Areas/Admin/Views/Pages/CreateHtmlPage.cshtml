@model HtmlPageCreationVM
@{
    ViewData["Title"] = Localizer["create_html_page"];
    ViewData["UnitTestPageClass"] = "ut-createPage";
     var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["html_creating_form"]</h3>
        </div>
        <div class="title_right">
            <a asp-action="Index"
               class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")
        

        <div class="x_panel">
            <div class="x_content">



                @{ string target = "CreateHtmlPage"; }

                <form asp-action="CreateHtmlPage" asp-controller="Pages" method="post"
                      enctype="multipart/form-data"
                      class="form-horizontal forn-new form-label-left m-t5"
                      id="CreatePageForm">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }
                    <input type="hidden" name="Lang" value="@activeLang" />


                    <div class="form-group clearfix">
                        <label asp-for="Title" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_title"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">

                        <label asp-for="Slug" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_slug"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="Slug" class="form-control" required />
                            <span asp-validation-for="Slug" class="text-danger invalid_field"></span>
                        </div>

                    </div>

                    <div class="form-group clearfix">

                        <label asp-for="Section" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_section"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="Section" class="form-control" />
                            <span asp-validation-for="Section" class="text-danger invalid_field"></span>
                        </div>
                    </div>


                    <div class="form-group clearfix">
                        <label asp-for="MainImage" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_main_image"]</label>

                        <div class="col-md-7 col-sm-9 col-xs-12">

                            <label class="form-control clearfix uploadfile">
                                <input type="file" asp-for="MainImage" class="upload-input" data-text='@Localizer["choose_file"]' accept="image/*" />
                                <span class="url">@Localizer["choose_file"]</span>
                                <span class="file-btn"><i class="fa fa-search"></i> @Localizer["Browse"]</span>
                            </label>
                            <span asp-validation-for="MainImage" class="text-danger invalid_field"></span>
                        </div>

                    </div>
                    <div class="form-group clearfix">
                        <label asp-for="AuthorName" class="control-label col-md-3 col-sm-3 col-xs-12">@Localizer["author_name"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <input type="text" asp-for="AuthorName" class="form-control" />
                            <span asp-validation-for="AuthorName" class="text-danger invalid_field"></span>
                        </div>
                    </div>
                    <div class="form-group clearfix">

                        <label asp-for="Summary" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_summary"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <textarea asp-for="Summary" class="form-control" rows="3" required> </textarea>
                            <span asp-validation-for="Summary" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group clearfix">
                        <label asp-for="Content" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_content"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <textarea asp-for="Content" class="form-control" rows="5" required></textarea>
                            <span asp-validation-for="Content" class="text-danger invalid_field"></span>
                        </div>
                    </div>
                    <h4>
                        SEO
                    </h4>
                    <hr />
                    <div class="form-group clearfix">
                        @{ string keywords = string.Empty; }
                        <label asp-for="Keywords" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_meta_keywords"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <div class="static-form-control">
                                <input type="text" asp-for="Keywords" class="form-control" id="keywords" />
                            </div>
                            <span asp-validation-for="Keywords" class="text-danger invalid_field"></span>
                        </div>
                    </div>
                    <div class="form-group clearfix">
                        <label asp-for="MetaDescription" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["f_meta_description"]</label>
                        <div class="col-md-7 col-sm-9 col-xs-12">
                            <textarea asp-for="MetaDescription" class="form-control MetaDescription"
                                      data-characters='{"warning_count" : 158  , "maximum_count"  : 300 }' rows="3"></textarea>
                            <span asp-validation-for="MetaDescription" class="text-danger invalid_field"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6 col-md-offset-3 col-sm-offset-3 col-sm-6 col-xs-12 ">
                            <input type="submit" class="btn btn-success p-x-5  ut-createbtn" value="@Localizer["Create"]" id="createBtn">
                            <input type="submit" class="btn btn-info p-x-5  ut-saveAndcontinue" value="@Localizer["save_and_continue"]" id="saveAndcontinue" name="save-continue">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@section Styles{
    <link href="~/Admin/lib/bootstrap-tagsinput/dist/bootstrap-tagsinput.css" rel="stylesheet" />
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/Admin/js/validator.min.js"></script>

    @{
        ViewBag.TinyMce_Contetnt_Id = "#Content";
        ViewBag.TinyMce_Suumry_Id = "#Summary";
        await Html.RenderPartialAsync("partials/_tinymce.cshtml");
    }

    <script src="~/Admin/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/Admin/lib/bootstrap-tagsinput/dist/bootstrap-tagsinput.js"></script>

    <script>
         $('.select_picker').select2();
         $('#keywords').tagsinput({
                    tagClass: 'tag'
         });
         $("#Title").on("keyup", function () {
             $("#Slug").val($(this).val().replace(/\s/g, "_")).valid();
         })
    </script>

}


