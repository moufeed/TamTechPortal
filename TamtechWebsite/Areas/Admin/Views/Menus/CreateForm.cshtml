@model MenuLiteDto
@{
    ViewData["Title"] = Localizer["create_menu"];
    ViewData["UnitTestPageClass"] = "ut-Menus_create";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}



@using (Html.BeginForm("Create", "Menus", FormMethod.Post,
new
{
   @class = "form-horizontal forn-new form-label-left",
   id = "MenuForm"
}))
{



    <div class="clearfix">
        <div class="page-title">
            <div class="title_left">
                <h3>@Localizer["create_menu"]</h3>
            </div>
            <div class="title_right">


                <a asp-action="Index" class="btn btn-default">
                    <span class="fa fa-chevron-left"></span> @Localizer["back_to_list"]
                </a>
                <button type="submit" name="save" class="btn btn-success ut-create_btn"><i class="fa fa-save"></i> @Localizer["save"] </button>
                <button type="submit" name="save-continue" class="btn  btn-blue ut-saveandcontinue">
                    <i class="fa fa-floppy-o"></i>
                    @Localizer["save_and_continue"]
                </button>
            </div>
        </div>
    </div>


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary()
        </div>
    }

    <input type="hidden" name="Lang" value="@activeLang" />

    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">

            @{
                ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };
            }
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")


            <div class="x_panel">

                <div class="row m-t5">
                    <div class="col-md-4 col-xs-12">
                        <div class="form-group clearfix">
                            <label for="Menutitle" class="control-label col-md-3 col-sm-12">@Localizer["f_title"]</label>
                            <div class="col-md-9 col-sm-12">
                                <input type="text" asp-for="Title" name="Title" id="Menutitle" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger invalid_field"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-xs-12">
                        <div class="form-group clearfix">
                            <label for="MenuKey" class="control-label col-md-3 col-sm-12">@Localizer["f_name"]<i class="fa fa-asterisk c-red fz-10 "></i></label>
                            <div class="col-md-9 col-sm-12">

                                <input type="text" asp-for="Key" id="MenuKey" class="form-control ut-menukey" required data-rule-slug="true" />
                                <span asp-validation-for="Key" class="text-danger invalid_field"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-xs-12">
                        <div class="form-group clearfix">
                            <label for="Position" class="control-label col-md-3 col-sm-12">@Localizer["f_position"]</label>
                            <div class="col-md-9 col-sm-12">
                                <select class="form-control" asp-for="Position">
                                    <option value="header">Header</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


}




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/Admin/js/validator.min.js"></script>
}