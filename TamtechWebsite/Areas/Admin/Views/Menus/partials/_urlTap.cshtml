@{
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}
<div role="tabpanel" class="tab-pane fade" id="@MenuItemTypeEnum.url.ToString()">


    <form asp-action="CreateMenuItemAsync" asp-controller="menus"
          method="post" class="form-horizontal forn-new form-label-left p-x-5 p-y-3 ut-link-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary()
            </div>
        }
        <input type="hidden" name="MenuId" value="@Model.Id" />
        <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.url.ToString()" />
        <input type="hidden" name="parentKey" value="" />
        <input type="hidden" name="Lang" value="@activeLang" />
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="text" name="Title" id="url-Title" class="form-control ut-title-input" required>
            </div>
        </div>

        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4">@Localizer["f_url"] <i class="fa fa-asterisk c-red fz-10 "></i></label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="text" name="Url" id="Url" class="form-control" required>
            </div>
        </div>

        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4">@Localizer["f_url_target"]</label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <select class="form-control" name="UrlTarget" id="UrlTarget">
                    <option value="_blank" selected>_blank</option>
                    <option value="_self">_self</option>
                    <option value="_parent">_parent</option>
                    <option value="_top">_top</option>
                </select>
            </div>
        </div>
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="number" name="DisplayOrder" id="UrlDisplayOrder" step="1" value="0" min="0" class="form-control ut-order-input">
            </div>
        </div>
        <div class=" clearfix text-right">
              <input type="submit" value="@Localizer["add_to_menu"]" class="btn btn-success ut-url-send">
            <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
        </div>

    </form>

</div>