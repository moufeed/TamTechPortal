        </li>*@

    <li role="presentation" data-type="dropdown">
        <a href="#@MenuItemTypeEnum.dropdown.ToString()"
           aria-controls="@MenuItemTypeEnum.dropdown.ToString()"
           role="tab"
           class="ut-submenu-tab"
