@{
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}
<div role="tabpanel" class="tab-pane fade " id="@MenuItemTypeEnum.dropdown.ToString()">
    <form asp-action="CreateMenuItemAsync" asp-controller="menus"
          method="post"
          class="form-horizontal forn-new form-label-left p-x-5 p-y-3 ut-submenu-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary()
            </div>
        }
        <input type="hidden" name="MenuId" value="@Model.Id" />
        <input type="hidden" name="ItemType" value="@MenuItemTypeEnum.dropdown.ToString()" />
        <input type="hidden" name="parentKey" value="" />
        <input type="hidden" name="Lang" value="@activeLang" />
        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_title"] </label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="text" name="Title" id="url-Title" class="form-control ut-title-input" required>
                <input type="hidden" name="Url" value="#" />
            </div>
        </div>

        <div class="form-group clearfix">
            <label class="control-label col-md-3 col-sm-4"> @Localizer["f_display_order"] </label>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <input type="number" name="DisplayOrder" id="dropdownDisplayOrder" step="1" min="0" value="0" class="form-control ut-order-input">
            </div>
        </div>
        <div class=" clearfix text-right">
             <input type="submit" value="@Localizer["add_to_menu"]" class="btn btn-success ut-submenu-send">
            <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["close"]</button>
        </div>

    </form>
</div>