@model  Smslite

@{
    ViewData["Title"] = "SmsDetails";
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>Text message <small></small></h3>
        </div>
        <div class="title_right">
            <a asp-action="Index"
               class="btn btn-default btn-add-new">Back</a>
        </div>
    </div>
</div>



<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel p-x-0">
            <div class="x_content ">
                <div class="clearfix">
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <strong> Recipients</strong>
                    </div>

                    <div class="col-md-7 col-sm-9 col-xs-12">
                        <div>
                            @foreach (var item in Model.Recipients)
                            {
                                <span class="m-y-1 m-x-1 badge">@item &nbsp;</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="clearfix m-t2">
                    <div class="col-md-3 col-sm-3 col-xs-12">
                        <strong> Message</strong>
                    </div>

                    <div class="col-md-7 col-sm-9 col-xs-12">
                        <p>@Model.Massage</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
