@model List<PostDto>

@{
    ViewData["Title"] = Localizer["Posts"];
    ViewData["UnitTestPageClass"] = "ut-posts-index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["Posts"] <small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("Create" , "Posts")"
               class="btn btn-blue btn-add-new ut-create-btn">
                <i class="fa fa-plus"></i>
            @Localizer["new_post"]</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @{
            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };
        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")

        <div class="x_panel p-x-0">

            <div class="x_content">

                <partial name="_Filters.cshtml" model="ViewBag.FilterModel" />


                <div class="table-responsive">
                    <table class="table table-middle table-striped posts-table" id="postsTable">
                        <thead>
                        <th width="100" class="text-center">@Localizer["t_image"]</th>
                        <th>@Localizer["t_title"]</th>
                        <th>@Localizer["t_section_parent"]</th>
                        <th>@Localizer["t_summary"]</th>

                        <th width="100" class="text-center">@Localizer["t_visibility"]</th>
                        <th width="175">@Localizer["t_actions"]</th>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr id="tr-@item.Id">
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.MainImage))
                                        {

                                            <img src="@item.MainImage" alt="" width="60" />
                                        }
                                        else
                                        {
                                            <img src="~/Admin/img/noimage.jpg" alt="" width="60" />
                                        }
                                    </td>
                                    <td style="min-width:150px">
                                        @item.Title
                                    </td>
                                    <td style="min-width:150px">
                                        @item.Section
                                    </td>
                                    <td>
                                        <div class="s-summary">
                                            @{
                                                string text = "";
                                                if (!string.IsNullOrWhiteSpace(item.Summary))
                                                {
                                                    text = Regex.Replace(item.Summary, "<.*?>", String.Empty);
                                                }
                                            }
                                            @Html.Raw(text)
                                        </div>
                                    </td>

                                    <td class="text-center">


                                        @if (item.Locked)
                                        {
                                             <if include-if="item.Published">
                                                <span class="label label-success">
                                                    <i class="fa fa-eye "></i>
                                                    @Localizer["t_published"]
                                                </span>
                                            </if>
                                            <if exclude-if="item.Published">
                                                <span class="label label-danger">
                                                    <i class="fa fa-eye-slash "></i>
                                                    @Localizer["t_unpublished"]
                                                </span>
                                            </if>
                                        }
                                        else
                                        {
                                            @if (item.Published)
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-status="true"
                                                   data-url="@Url.AdminUrl("PublishAsync","Posts" , new { id = item.Id})"
                                                   title="@Localizer["t_unpublish"]"
                                                   data-unpublished="@Localizer["t_unpublished"]"
                                                   data-published="@Localizer["t_published"]"
                                                   class="btn btn-link-pup published ut-published toggle_publish">
                                                    <i class="fa fa-eye c-green"></i>
                                                    <small>@Localizer["t_published"]</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-url="@Url.AdminUrl("PublishAsync","Posts" , new { id = item.Id})"
                                                   title="@Localizer["t_publish"]"
                                                   data-unpublished="@Localizer["t_unpublished"]"
                                                   data-published="@Localizer["t_published"]"
                                                   class="btn btn-link-pup unpublished ut-unpublished toggle_publish">
                                                    <i class="fa fa-eye-slash c-red"></i>
                                                    <small>@Localizer["t_unpublished"]</small>
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_details"]"
                                               href="@Url.AdminUrl("Details","Posts",new { id = item.Id })"
                                               class="btn btn-view btn-round ut-detail-btn"><i class="fa fa-info "></i></a>

                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               title="@Localizer["t_edit"]"
                                               href="@Url.AdminUrl("Edit" ,"Posts",new { id = item.Id })"
                                               class="btn btn-edit btn-round ut-edit-btn"><i class="fa fa-edit "></i></a>

                                            <if include-if="item.Locked">
                                                <span data-toggle="tooltip"
                                                      data-placement="top"
                                                      class="btn-locked btn-round"
                                                      title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                            </if>

                                            <if exclude-if="item.Locked">
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   data-id="@item.Id"
                                                   data-url="@Url.AdminUrl("DeleteAsync", "Posts", new { id = item.Id })"
                                                   title="@Localizer["t_remove"]"
                                                   class="btn btn-remove btn-round delete-post ut-remove-btn"><i class="fa fa-times "></i></a>
                                            </if>

                                        </div>

                                    </td>
                                </tr>

                            }
                            
                                <if include-if='Model.Count == 0'>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p class="empty_row">
                                                <i class='fa fa fa-exclamation-circle'></i>
                                                @Localizer["no_data_table"]
                                            </p>
                                        </td>
                                    </tr>
                                </if>
                             

                        </tbody>
                        </table>
                </div>

                <hr class="m-y-2" />
                <pagination controller-name="posts" filter-model="ViewBag.FilterModel" pagniation-model="ViewBag.pagination" total="true"></pagination>
            </div>
        </div>
    </div>
</div>



@section Styles{
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}


@section Scripts {
    <script src="~/Admin/js/posts.min.js"></script>
    <script src="~/Admin/lib/select2/dist/js/select2.js"></script>
    <script>
        $('.select_no-search').select2({ minimumResultsForSearch: -1});
        $('.select_picker').select2();
    </script>
}
