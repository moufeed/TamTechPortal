@model  ProductFormVM


<div class="form-group clearfix">
   
    <label asp-for="Name" class="control-label col-md-3 col-sm-3 col-xs-12">@Localizer["f_name"]</label>
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger invalid_field" })
    </div>
</div>

<div class="form-group clearfix">
    <label asp-for="ShortDescription" class="control-label col-md-3 col-sm-3 col-xs-12">@Localizer["f_short_description"]</label>
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextAreaFor(m => m.ShortDescription, new { @class = "form-control", rows = "5" })
        @Html.ValidationMessageFor(m => m.ShortDescription, "", new { @class = "text-danger invalid_field" })
    </div>
</div>

<div class="form-group clearfix">
    <label asp-for="FullDescription" class="control-label col-md-3 col-sm-3 col-xs-12">@Localizer["f_full_description"]</label>
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextAreaFor(m => m.FullDescription, new { @class = "form-control", rows = "5" })
        @Html.ValidationMessageFor(m => m.FullDescription, "", new { @class = "text-danger invalid_field" })
    </div>
</div>
<div class="form-group clearfix">
    <label asp-for="SKU" class="control-label col-md-3 col-sm-3 col-xs-12">@Localizer["f_sku"]</label>
    <div class="col-md-8 col-sm-8 col-xs-12">
        @if (ViewBag.isUpdate)
        {
            <p class="form-control-static" id="SKU">@Model.SKU</p>
            @Html.HiddenFor(m => m.SKU, new { @class = "form-control" })
        }
        else
        {
            @Html.TextBoxFor(m => m.SKU, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.SKU, "", new { @class = "text-danger invalid_field" })
        }
    </div>
</div>

