@model Brand

@{
    ViewData["Title"] = "Details";
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>Details</h3>
        </div>
        <div class="title_right">
            <a asp-action="Index"
               class="btn btn-default"><span class="fa fa-chevron-left"></span>Back to List</a>
        </div>
    </div>
</div>



<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
