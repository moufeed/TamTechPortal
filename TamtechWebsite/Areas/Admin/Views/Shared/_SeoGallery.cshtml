@model Gallery


<input type="hidden" name="Seo[Type]" id="SeoType" value="ImageGallery" />
<input type="hidden" name="Seo[data][DatePublished]" value="@Model.PublishedDate" asp-for="PublishedDate" />
<input type="hidden" name="Seo[data][DateModified]" value="@Model.ModifiedDate" asp-for="ModifiedDate" />
<input type="hidden" name="Seo[data][Image]" value="@Model.Image" asp-for="Image" />
<input type="hidden" name="Seo[data][author][Type]" asp-for="Author.Type" />
 

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["gallery_name"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="text" name="Seo[data][name]" class="form-control" value="@Model.Name" asp-for="Name" />
    </div>
</div>
<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["gallery_description"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <textarea name="Seo[data][Description]" rows="3" class="form-control" asp-for="Description"></textarea>
    </div>
</div>
<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["gallery_author"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="text" class="form-control" name="Seo[data][author][name]" value="@Model.Author.Name" asp-for="Author.Name" />
    </div>
</div>
