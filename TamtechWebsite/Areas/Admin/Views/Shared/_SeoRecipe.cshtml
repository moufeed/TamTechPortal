@model RecipeModel


<input type="hidden" name=Seo[Type] id="SeoType" value="Recipe" />

<input type="hidden" name="Seo[data][DatePublished]" value="@Model.PublishedDate" asp-for="PublishedDate" />
<input type="hidden" name="Seo[data][DateModified]" value="@Model.ModifiedDate" asp-for="ModifiedDate" />
<input type="hidden" name="Seo[data][author][Type]" asp-for="Author.Type" />

<input type="hidden" name="Seo[data][Image]" value="@Model.Image" asp-for="Image" />

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_name"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="text" name="Seo[data][name]" class="form-control" asp-for="Name" />
    </div>
</div>


<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_keywords"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input name="Seo[data][Keywords]" class="form-control" asp-for="Keywords" />
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["Author"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="text" class="form-control" name="Seo[data][author][name]" value="" />
    </div>
</div>
<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_description"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <textarea name="Seo[data][Description]" rows="3" class="form-control" asp-for="Description"></textarea>
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_category"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="text" name="Seo[data][recipeCategory]" class="form-control" asp-for="RecipeCategory" />
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_cuisine"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="text" name="Seo[data][recipeCuisine]" class="form-control" asp-for="RecipeCuisine" />
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["cook_time"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        @{ 

//int ConvertToINt(string val)
//{
