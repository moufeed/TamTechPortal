//    string repStr = val.Replace("PT", "").Replace("M", "");
//    string[] strArray = repStr.Split('H');

//    int Hours = System.Convert.ToInt32(strArray[0]);

//    int minutes = System.Convert.ToInt32(strArray[1]);

//    result = (Hours * 60) + minutes;

//    return result;
//}

//int CookTime = 0;
//if (!string.IsNullOrEmpty(Model.CookTime))
//{

//    CookTime = ConvertToINt(Model.CookTime);

//}
        }
        <input type="number" name="Seo[data][cookTime]" class="form-control" placeholder="@Localizer["time_in_minutes"]" value="@Model.CookTime" />
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["prep_time"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="number" name="Seo[data][prepTime]" class="form-control" placeholder="@Localizer["time_in_minutes"]" asp-for="PrepTime" />
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["total_time"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="number" name="Seo[data][totalTime]" class="form-control" placeholder="@Localizer["time_in_minutes"]" asp-for="TotalTime" />
    </div>
</div>

<div class="form-group">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["number_of_servings"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12">
        <input type="number" name="Seo[data][recipeYield]" class="form-control" asp-for="RecipeYield" />
    </div>
</div>
<hr />
<div class="form-group ">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_ingredient"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12 recipeIngredient">
        <div class="input-group mb-3 add-ingredient">
            <input type="text" class="form-control" id="input-recipeIngredient" placeholder="@Localizer["add_ingredient"]">
            <div class="input-group-addon">
                <button class="btn btn-success btn-add-ingredient" type="button"> <i class="fa fa-plus"></i> @Localizer["Add"] </button>
            </div>
        </div>
        <div class="recipeIngredient-items">
            @if (Model.RecipeIngredient != null && Model.RecipeIngredient.Count > 0)
            {
                @foreach (var item in Model.RecipeIngredient)
                {
                    <div class="input-Ingredient">
                        <input type="text" class="form-control" id="" name="Seo[data][recipeIngredient][]" value="@item">
                        <button class="btn btn-danger remove-input-item" type="button" data-type="recipeIngredient"><i class="fa fa-times"></i></button>
                    </div>
                }
            }
        </div>
    </div>
</div>
<hr />
<div class="form-group ">
    <label for="" class="control-label col-md-3 col-sm-3 col-xs-12 ">@Localizer["recipe_instructions"]</label>
    <div class="col-md-7 col-sm-9 col-xs-12 recipeInstructions">
        <div class="input-group mb-3 add-Instructions">
            <input type="text" class="form-control" id="input-recipeInstructions" placeholder="@Localizer["add_instructions"]">
            <div class="input-group-addon">
                <button class="btn btn-success btn-add-Instructions" type="button"> <i class="fa fa-plus"></i> @Localizer["Add"] </button>
            </div>
        </div>
        <div class="recipeInstructions-items">
            @if (Model.RecipeInstructions != null && Model.RecipeInstructions.Count > 0)
            {
                @foreach (var item in Model.RecipeInstructions)
                {
                    <div class="input-Ingredient">
                        <input type="text" class="form-control" id="" name="Seo[data][recipeInstructions][]" value="@item">
                        <button class="btn btn-danger remove-input-item" type="button" data-type="recipeInstructions"><i class="fa fa-times"></i></button>
                    </div>
                }
            }
        </div>
    </div>
</div>