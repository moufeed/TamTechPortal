
@model  List<Product>

<section class="section-compare">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/blocks/_categories.cshtml")
 
            </div>
         <div class="col compare-box py-3 ">
                    <h3 class="title-bottom-border"><strong>Compare products</strong></h3>

                    <div class="table-responsive">
                        <table class="table table-compare ">
                            <colgroup>
                                <col width="15" style="min-width:100px">
                                @{
                                    List<string> SKUS = new List<string>();
              
                                    double width = (Model.Count > 0) ? 85 / Model.Count : 30 ;
                                    int index = 0;
                                }

                                @foreach (var pro in Model)
                                {
                                    SKUS.Add(pro.SKU);
                                    if ((index % 2) != 0)
                                    {<col width="@width" class="bg-light"> }
                                    else { <col width="@width"> }
                                    index++;
                                }



                            </colgroup>
                            <thead>


                                <tr>

                                    <th scope="row"></th>
                                     
                                    @foreach (var item in Model)
                                    {
                                        List<string> skuList = new List<string>();

                                        foreach (var sku in SKUS)
                                        {
                                            if(sku != item.SKU)
                                            {
                                                skuList.Add(sku);
                                            }
                                        }


                                        var link = String.Join(",", skuList);

                                    <td>
                                        @if (Model.Count > 1)
                                        {

                                            <a  href="@Url.Action("Compare", "Products", new {products=link})"
                                               class="btn btn-link btn-remove" onclick="$productManage.RemoveFromCompare('@item.SKU', '@Url.Action("Compare", "Products", new {products=link})', event )">
                                                <i class="fa fa-trash"></i>
                                                remove
                                            </a>
                                        }


                                    </td>
                                    }
                                </tr>
                            </thead>
                            <tbody>

                                <tr class="image-row">
                                    <th scope="row">
                                        Product Picture
                                    </th>

                                    @foreach (var product in Model)
                                    {
                                        <td>
                                            <a asp-area="Shop" asp-action="Preview" asp-controller="Products" asp-route-id="@product.Id">
                                                <img src="@product.MainImageUrl" class="img-fluid" alt="">
                                            </a>
                                        </td>
                                    }



                                </tr>



                                <tr class="name-row">
                                    <th scope="row">Name</th>
                                    @foreach (var product in Model)
                                    {
                                        <td>
                                            <a asp-area="Shop" asp-action="Preview" asp-controller="Products" asp-route-id="@product.Id" class="text-truncate">
                                                @product.Name
                                            </a>
                                        </td>
                                    }


                                </tr>

                                <tr>
                                    <th scope="row">Rating</th>


                                    @foreach (var product in Model)
                                    {
                                        <td class="text-center">

                                            <span class="rating">
                                                @for (var i = 0; i < 5; i++)
                                                {
                                                    @if (i < product.Rate)
                                                    {
                                                        <i class="fa fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-star-o"></i>
                                                    }
                                                }
                                            </span>
                                            <span class="reviews-count"><b>0</b> Reviews </span>
                                        </td>
                                    }




                                </tr>
                                <tr class="manufacturer-row">
                                    <th scope="row">Manufacturer</th>
                                    @foreach (var product in Model)
                                    {
                                        <td>
                                            @product.Brand.Name
                                        </td>
                                    }

                                </tr>
                                <tr class="price-row">
                                    <th scope="row">Price</th>

                                    @foreach (var product in Model)
                                    {
                                        <td>
                                            <span>@product.Price</span>
                                            <small></small>
                                        </td>
                                    }



                                </tr>
                                <tr class="price-row">
                                    <th scope="row">Discount price</th>

                                    @foreach (var product in Model)
                                    {
                                        <td>
                                            @if (product.DiscountPrice != null && product.DiscountPrice < product.Price)
                                            {
                                                <span>@product.DiscountPrice</span>
                                                <small></small>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }

                                        </td>
                                    }



                                </tr>
                                <tr class="stock-row">
                                    <th scope="row">Stock</th>
                                    @foreach (var product in Model)
                                    {
                                        @if (product.StockQuantity != null && product.StockQuantity > 0)
                                        {
                                            <td>@product.StockQuantity</td>
                                        }
                                        else
                                        {
                                            <td>out of stouck </td>
                                        }
                                    }
                                </tr>
                                <tr class="description-row">
                                    <th scope="row">Description</th>

                                    @foreach (var product in Model)
                                    {

                                        <td>
                                            <p>
                                                @product.ShortDescription
                                            </p>
                                        </td>

                                    }

                                </tr>
                                <tr class="shipping-row">
                                    <th scope="row">Shipping</th>

                                    @foreach (var product in Model)
                                    {
                                        @if (product.IsFreeShipping)
                                        {
                                            <td>
                                                free shipping
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <strong>-</strong>
                                            </td>
                                        }
                                    }
                                </tr>


                            </tbody>
                            <tfoot>
                                <tr>
                                    <td></td>
                                    @foreach (var product in Model)
                                    {
                                        <td>
                                            <button class="btn btn-success btn-block" onclick="$productManage.AddToCart('@product.Id' , 1)">
                                                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                                                Add to cart
                                            </button>
                                        </td>

                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
            </div>

        </div>
    </div>
</section>