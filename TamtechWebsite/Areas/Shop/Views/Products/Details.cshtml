@model Product
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor accessor
@{
    ViewData["Title"] = "Details";
    Uri GetAbsoluteUri()
    {

        UriBuilder uriBuilder = new UriBuilder();
        uriBuilder.Scheme = accessor.HttpContext.Request.Scheme;
        uriBuilder.Host = accessor.HttpContext.Request.Host.Host;
        uriBuilder.Path = accessor.HttpContext.Request.Path.ToString();
        uriBuilder.Query = accessor.HttpContext.Request.QueryString.ToString();
        return uriBuilder.Uri;
    }

    var url = GetAbsoluteUri();
}

 

@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <meta property="og:type" content="product" />
    <meta property="og:url" content="@url" />
    <meta property="og:title" content="@Model.Name" />
    <meta property="og:image" content="@Model.MainImageUrl" />
}

<section class="product-section">
    <div class="container product-details">
        <div class="row">
            <div class="col-md-6 col-lg-5">
                @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_Carousel.cshtml", Model)

                <div class="sharebar">
                    <strong class="label">
                        Share :
                    </strong>
                    <ul class="list-unstyled clearfix list-inline" data-window-title="Share on">
                        <li>
                            <a href="https://twitter.com/share?url=@ViewBag.url " class="sharebtn twitter" data-toggle="tooltip" data-placement="top" title="twitter">
                                <i class="fa fa-twitter"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@ViewBag.url " class="sharebtn facebook" data-toggle="tooltip" data-placement="top" title="facebook">
                                <i class="fa fa-facebook"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://plus.google.com/share?url=@ViewBag.url " class="sharebtn google-plus" data-toggle="tooltip" data-placement="top" title="google plus">
                                <i class="fa fa-google-plus"></i>
                            </a>
                        </li>

                        <li>
                            <a href="https://www.tumblr.com/share/link?url=@ViewBag.url " class="sharebtn tumblr" data-toggle="tooltip" data-placement="top" title="tumblr">
                                <i class="fa fa-tumblr"></i>
                            </a>
                        </li>

                        <li>
                            <a href="https://www.pinterest.com/pin/create/button/?url=@ViewBag.url " class="sharebtn pinterest" data-toggle="tooltip" data-placement="top" title="pinterest">
                                <i class="fa fa-pinterest-p"></i>
                            </a>
                        </li>
                    </ul>

                </div>

            </div>
            <div class="col-md-6 col-lg-7">
                @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_ProductDetails.cshtml", Model)
            </div>
        </div>
    </div>




    <div class="container product-information mt-5">
        <div class="col">
            @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_ProductInformationsTabs.cshtml", Model)
        </div>
    </div>
</section>




@await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_Related_products.cshtml")

@section footer{
    <script src="~/Shop/js/jquery-validate.min.js"></script>
    <script src="~/Shop/js/product.min.js"></script>
}