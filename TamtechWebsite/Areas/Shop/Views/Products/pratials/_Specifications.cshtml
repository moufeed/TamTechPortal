@model Product





@if (Model.Specifications != null && Model.Specifications.Count > 0)
{
<div class="table-responsive">
    <table class="table table-specifications">
        <colgroup>
            <col width="25%">
            <col>
        </colgroup>
        <tbody>

            @foreach(var item in Model.Specifications){

             <tr>
                <td>@item.Key</td>
                <td>@item.Value</td>
            </tr>

            }

        </tbody>
    </table>
</div>
}




