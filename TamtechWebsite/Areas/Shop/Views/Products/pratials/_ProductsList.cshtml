<div class="row products-view grid-view no-gutters">

  

    @foreach (var product in Model)
    {
            
<div class="col-md-6 col-lg-4 pro-item">
<div class="product-box">
    <div class="product-ribbons">
        
        <div class="product-image d-flex justify-content-center align-items-center">
            <img src="@product.MainImageUrl" alt="@product.Name">
        </div>

        <div class="product-action">
            <a asp-area="Shop" asp-action="Preview" asp-controller="Products" asp-route-id="@product.Id" class="product-link"> </a>
                  <button class="btn btn-whitelist" data-toggle="tooltip" data-placement="top"  title="Add to whitelist" onclick="$productManage.AddToWhitelist(12)">
                    <i class="fa fa-heart-o" aria-hidden="true"></i>
                </button> 

                 <button class="btn btn-compare "  data-toggle="tooltip" data-placement="top" data-sku="@product.SKU" title="Add To Compare" onclick="$productManage.AddToCompare('@product.SKU','/Shop/Products/compare',this)">
                   <i class="fa fa-exchange" aria-hidden="true"></i>
                </button>
 
        </div>

        <div class="products-ribbons">
            @*<span class="ribbon new">New</span>*@
            @if (product.HasDiscount) {
                <span class="ribbon offer">@product.DiscountedPercentage</span>
            }
        </div>
    </div>

    <div class="pro-info">
        <div class="product-info">
            <a asp-area="Shop" asp-action="Preview" asp-route-id="@product.Id" class="title">
                @product.Name
            </a>
            <div class="prices d-flex justify-content-center">
                <span class="price"> @product.NewPrice</span>
                @if (product.HasDiscount) 
                {
                 <span class="old-price">@product.OldPrice</span>
                }
            </div>
    </div>
        <div class="product-description">
            @product.ShortDescription
        </div>
    <div class="product-footer">
        <button class="btn addtocart" onclick="$productManage.AddToCart(12)">
               <i class="fa fa-shopping-basket" aria-hidden="true"></i>
               add to cart
        </button>
    </div>
    </div>

</div>


</div>
}

</div>