 

  
<div class="product-selectors d-flex justify-content-between align-items-center">
    <div class="col-sm-auto pagesize">
        <span>Display</span>
         
            <select name="pageSize" id="pageSize"
                    asp-items="ViewBag.pageSize"
                    class="pagesize-selector"></select>
        <span class="d-md-none d-lg-inline">per page</span>
    </div>
    <div class="col-sm-auto productsort">
        <span>Sort by</span>
        <select  name="sortPage" id="sortPage"
                asp-items="ViewBag.sortList"
                class="sortoptions-selector" ></select>
    </div>
    <div class="col-sm-auto viewtype d-none d-sm-inline">
        <a class="btn btn-link view-selector view-selector-list" href="#" data-toggle="tooltip" data-placement="top" title="List">
            <i class="fa fa-list" aria-hidden="true"></i>
        </a>
        <a class="btn btn-link view-selector view-selector-grid active" href="#" data-toggle="tooltip" data-placement="top" title="Grid">
            <i class="fa fa-th" aria-hidden="true"></i>
        </a>
    </div>
</div>