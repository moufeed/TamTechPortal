@model Product
<div class="product-carousel">
    <div class="light-slider" id="productcarousel" data-left='&#xf104;' data-right='&#xf105;'>
        <div class="item" data-thumb="@Model.MainImageUrl">
            <img src="@Model.MainImageUrl" class="img-fluid">
        </div>

        @if (Model.Images != null && Model.Images.Count > 0)
        {

            @foreach (var img in Model.Images)
            {
                <div class="item" data-thumb="@img">
                    <img src="@img" class="img-fluid">
                </div>
            }
        }
    </div>
</div>


