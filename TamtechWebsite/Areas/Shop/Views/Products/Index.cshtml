
@model List<ProductListVM>
@{
    Layout = "_Layout";
}

@section SEO{
    <meta name="robots" content="noindex">
}


<section class="section products_section">
    <div class="container">
        <div class="row">
            <div class="col-md-4 col-lg-3">

                @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_sidebar.cshtml")

            </div>
            <div class="col-md-8 col-lg-9">
                @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_productsSelectors.cshtml")

                @await Html.PartialAsync("~/Areas/shop/Views/Products/pratials/_ProductsList.cshtml", @Model)





                <div class="clerfix pagination-row mt-4 no-gutters">

                    @if (ViewBag.pagination.PreviousPage)
                    {
                        <button class="btn btn-outline-secondary previous pull-left flip-dir" data-page="@ViewBag.FilterModel.PageNumber" onclick="window.history.back()">
                            <i class="fa fa-angle-left"></i>
                            Previous
                        </button>
                    }
                    @if (ViewBag.pagination.NextPage)
                    {
                        <button class="btn btn-outline-secondary next pull-right flip-dir" data-page="@ViewBag.pagination.PageNumber" onclick="generateUrl('@ViewBag.pagination.PageNumber')">
                            Next
                            <i class="fa fa-angle-right"></i>
                        </button>
                    }
                </div>

            </div>
        </div>
    </div>
</section>


@section footer{
    <script>
         $(document).ready(function(){

            if(localStorage.getItem('comparelist') != null){
                var list = JSON.parse(localStorage.getItem('comparelist'));
                    $.each(list,function(i,sku){
                            $('.btn-compare[data-sku="'+sku+'"]').addClass('inlist').tooltip('dispose');
                    })
            }
        })
    </script>
}