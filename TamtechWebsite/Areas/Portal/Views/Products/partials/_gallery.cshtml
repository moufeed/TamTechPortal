
<div class="row gallery">



    @foreach (var product in Model)
    {

        <div class="col-md-6 col-lg-3">
            <article class="gallery-item">
                <figure>
                    <img src="@product.MainImageUrl" alt="">
                    <figcaption>
                        <a asp-controller="Products" asp-action="v" asp-route-id="@product.Id">
                            <i class="fa fa-link"></i>
                        </a>
                    </figcaption>
                </figure>
                <h5>
                    <a asp-controller="products" asp-action="v" asp-route-id="@product.Id" class="link">
                        @product.Name
                    </a>
                </h5>
                <span class="text-uppercase category">@product.SKU</span>
            </article>
        </div>
    }



 

</div>

 