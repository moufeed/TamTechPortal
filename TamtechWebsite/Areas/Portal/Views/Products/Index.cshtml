 
@model List<ProductListVM>
@{
    ViewData["Title"] = Localizer["Products"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/products.jpg");
    ViewData["pageTitle"] = Localizer["Our_products"];
}

@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml")

<section class="section-products">
    <div class="container">
        @await Html.PartialAsync("~/Areas/Portal/Views/Products/partials/_gallery.cshtml", Model)



        <div class="clerfix pagination-row mt-4 no-gutters">

            @if (ViewBag.pagination.PreviousPage)
            {
                <button class="btn btn-outline-secondary previous pull-left flip-dir" data-page="@ViewBag.FilterModel.PageNumber" onclick="window.history.back()">
                    <i class="fa fa-angle-left"></i>
                    @Localizer["Previous"]
                </button>
            }
            @if (ViewBag.pagination.NextPage)
            {
                <a href="@Url.Action("Index","Products" ,new { pagenumber=ViewBag.pagination.PageNumber})" class="btn btn-outline-secondary next pull-right flip-dir">

                    @Localizer["Next"]
                    <i class="fa fa-angle-right"></i>

                </a>
   
            }
        </div>

    </div>
</section>