@model PageDto
@{
    ViewData["Title"] = String.IsNullOrEmpty(Model.Title) ? "TamTech" : Model.Title;
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/about.jpg");
    ViewData["pageTitle"] = @Model.Title;

    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "EditSectionsPage";
}


@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)



@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
    <meta name="keywords" content="@(String.Join(',', Model.Keywords))">
}




<section class="section-page py-5">
    <div class="container">
        <div class="row align-items-center mb-5">

            @{ int classname = 12; }

            @if (Model.MainImage?.Length > 0)
            {
                <div class="col-md-5 ">

                    <div class="page-mainimage  d-flex justify-content-center align-items-center">
                        <img src="@Model.MainImage" alt="@Model.Title" />
                    </div>
                </div>

                classname = 7;
            }


            <div class="col-md-@classname">
                <div class="page-summary">

                    <div class="page-meta">

                        @if (Model.ContentPublishDate != null)
                        {
                        <small class=""> <i class="fa fa-calendar"></i> @((DateTime)Model.ContentPublishDate).ToString("MMMM dd, yyyy")</small>
                        }

                        @if (Model.Section?.Length > 0)
                        {
                            <small><i class="fa fa-folder-o" aria-hidden="true"></i>  @Model.Section </small>
                        }


                    </div>


                    <div class="page-summary mt-3 mb-2">
                        @Html.Raw(Model.Summary)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <aside class="col-md-4 col-lg-3">
                @{int key = 0; int index = 0;}
                <div class="list-group list-group-flush list-keys">
                    @foreach (var content in Model.SectionsContent)
                    {
                        <a href="#content-@(key)" class="list-group-item list-group-item-action d-inline-block text-truncate">@content.Key</a>
                        key++;
                    }
                </div>

            </aside>

            <div class="col-md-8 col-lg-9 ">
                @foreach (var content in Model.SectionsContent)
                {
                    <article class="article-content" id="content-@(index)">
                        <h5 class="title-underline"><strong>@content.Key</strong></h5>
                        <p>
                            @content.Value
                        </p>
                    </article>
                    index++;
                }
            </div>
        </div>
    </div>
</section>

