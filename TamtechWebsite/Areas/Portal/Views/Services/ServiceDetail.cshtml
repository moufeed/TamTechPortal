@model ServiceDto
@{
    ViewData["Title"] = Localizer["Services"];
    Layout = "_Layout";
     
    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "edit";
}

<partial name="_serverHeader.cshtml" model="Model" />



<section class="section-content service-bg">
    <div class="container">
        <div class="row justify-content-center">
            <if include-if="@Model.IconVisibility">
                <div class="col-auto">
                    <div class="serviceicon  d-md-none d-lg-block">
                        <i class="fa @Model.Icon sc-icon"></i>
                    </div>
                </div>
            </if>
            
            <div class="col">
                @Html.Raw(Model.Content)
            </div>
        </div>
    </div>
</section>


  



@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}
