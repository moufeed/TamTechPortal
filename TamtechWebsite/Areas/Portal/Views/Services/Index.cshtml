@model List<ServiceDto>
@{
    ViewData["Title"] = Localizer["Services"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/headers/services.jpg");
    ViewData["pageTitle"] = Localizer["our_services"];
 
}

<partial name="~/Areas/Portal/Views/Shared/partials/_StaticHeader.cshtml" model="ViewData" />



<section class="section-content sections-list">

    @if (Model != null && Model.Count > 0)
    {
        int i = 1;
        foreach (var service in Model)
        {
    <div class="@(i%2 ==0 ? "reverse" :"") service-item  ">
        <div class="container">
            <div class="row justify-content-between align-items-center  @(i%2 ==0 ? "flex-row-reverse":"")">
                <div class="col-md-4 col-lg-3 service-icon">
                    @if (service.IconVisibility && !string.IsNullOrEmpty(service.Icon))
                    {
                        <i class="fa @service.Icon"></i>
                    }
                    else if (!string.IsNullOrEmpty(service.MainImage) && !service.IconVisibility)
                    {
                        <div class="Image d-flex justify-content-center align-items-center">
                            <img src="@service.MainImage" alt="">
                        </div>
                    }
                    else
                    {
                        <i class="fa fa-cubes"></i>
                    }

                </div>
                <div class="col-md-8">
                    <div class="service-description">
                        <h3 class="bb-title">
                            <a asp-controller="services"
                               asp-action="v"
                               asp-route-slug="@service.Slug"  >@service.Title</a>
                             
                        </h3>
                        <p class="summary">
                            @Html.Raw(service.Summary)
                        </p>
                        @if (!string.IsNullOrEmpty(service.Content))
                        {
                            <a asp-controller="services"
                               asp-action="v"
                               asp-route-slug="@service.Slug" class="jump-link">@Localizer["read_more"]</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        
    </div>

            i++;
        }
    }

        

</section>

<section class="services-section">

    
    @if (Model != null && Model.Count > 0)
    {
        int i = 1;

        foreach (var service in Model)
        {
            <div class="service-feature @(((i % 2) == 0)? "even" :"") ">
                <div class="container">
                    
                    <div class="row align-items-center">
                         
                        <div class="col-md-8  @(((i % 2) == 0)? "order-first" :"")">
                            <div class="service-description">
                               
                                <div>
                                   
                                </div>
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            i++;
        }
    }






     


</section>

