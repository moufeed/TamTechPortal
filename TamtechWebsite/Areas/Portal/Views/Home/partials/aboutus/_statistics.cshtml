<section class="statistics_section">
    <div class="container">
        <div class="row justify-content-between">
            <div class="col-6 col-md-3">
                <div class="divcenter text-center">
                    <i class="ico icon-users-outline" aria-hidden="true"></i>
                    <div class="counter">
                        <span>2000</span>
                    </div>
                    <h5>@Localizer["happy_clients"]</h5>
                </div>
            </div>
            <div class="col-6 col-md-3 ">
                <div class="divcenter text-center">
                    <i class="ico icon-calendar" aria-hidden="true"></i>
                    
                    <div class="counter">
                        <span>15</span>
                    </div>
                    <h5>@Localizer["years_in_business"]</h5>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="divcenter text-center">
                    <i class="ico icon-cup" aria-hidden="true"></i>
                    <div class="counter">
                        <span>403</span>
                    </div>
                    <h5>@Localizer["cups_of_coffee"]</h5>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="divcenter text-center">
                    <i class="ico icon-briefcase" aria-hidden="true"></i>
                    <div class="counter">
                        <span>950</span>
                    </div>
                    <h5>@Localizer["no_projects"]</h5>
                </div>
            </div>
        </div>
    </div>
</section>