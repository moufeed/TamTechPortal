@model  CreateRequestModel
@{
    ViewData["Title"] = Localizer["request_quote"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/headers/qute.jpeg");
    ViewData["pageTitle"] = Localizer["request_quote"];
}

<partial name="~/Areas/Portal/Views/Shared/partials/_StaticHeader.cshtml" model="ViewData" />


<section class="section-content">
    <div class="container">
        <header class="text-center">
            <p class="lead">
                @Localizer["request_lead_msg"]
            </p>
        </header>

        <if include-if="@TempData["Success"] != null">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <h4 class="alert-heading">@Localizer["thank_you_for_your_quote_request"]</h4>
                <p>
                    @Localizer["We_appreciate_your_taking_the_time_to_submit_your_quote_request"]
                </p>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
             
        </if>

        <form asp-action="request" method="post" class="my-5">
            <if include-if="!ViewData.ModelState.IsValid">
                <div asp-validation-summary="All" class="alert alert-danger">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </if>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="FullName">@Localizer["l_full_name"]</label>
                    <input type="text" class="form-control " placeholder="@Localizer["l_full_name"].." asp-for="FullName" required />
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Email">@Localizer["l_email"]</label>
                    <input type="email" class="form-control " placeholder="@Localizer["l_email"].." asp-for="Email" >
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Mobile">@Localizer["l_mobile"]</label>
                    <input type="tel" class="form-control " placeholder="@Localizer["l_mobile"].." asp-for="Mobile" required/>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Phone">@Localizer["l_phone"]</label>
                    <input type="tel" class="form-control " placeholder="@Localizer["l_phone"].." asp-for="Phone" />
                </div>
                
                
                
                <div class="form-group col-md-12">
                    <label asp-for="Address">@Localizer["l_address"]</label>
                    <textarea class="form-control " cols="30" rows="2" placeholder="@Localizer["l_address"].." asp-for="Address"></textarea>
                </div>

                <div class="form-group col-md-12">
                    <label asp-for="Notes">@Localizer["l_notes"]</label>
                    <textarea cols="30" rows="5" class="form-control" placeholder="@Localizer["l_notes"].." asp-for="Notes"></textarea>
                </div>

                <div class="form-group d-flex justify-content-between align-items-end col-md-12">
                    
                    <button type="submit" class="btn btn-send btn-lg   ">
                        @Localizer["request"]
                    </button>
                </div>
                
            </div>

            
            
            

            


           

           



        </form>
        
    </div>
</section>


       
 