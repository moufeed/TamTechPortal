<section class="section contact">
    <div class="container">
        <div class="section_title text-center" data-content="Contact Us">
            <h2 data-animate="fadeInUp" data-delay="400">
                <strong>Contact Us</strong>
            </h2>
            <!--<p data-animate="fadeInUp">
                TAMTech is glad to hear from you.
            </p>-->
        </div>
        <div class="row align-items-center">
            <div class="col-md-6 contact-info">
                <div class="row " data-animate="fadeIn" data-delay="100">
                    <div class="col-xs-12 col-sm-auto">

                        <svg>
                            <use xlink:href="@Url.Content("~/Portal/img/sprite.svg#placeholder") " />
                        </svg>

                    </div>
                    <div class="col">
                        <h5 class="subtitle ">Address</h5>
                        <Address>
                            University Mh. E5 bypass Civan Cokak No: 1 <br />
                            Allure Tower Kat 7 Apartment No: 94 <br />
                            34320 Avcılar, Istanbul
                        </Address>
                    </div>
                </div>
                <div class="row" data-animate="fadeIn" data-delay="200">
                    <div class="col-xs-12 col-sm-auto">
                        <svg>
                            <use xlink:href="@Url.Content("~/Portal/img/sprite.svg#phone-call")" />
                        </svg>
                    </div>
                    <div class="col">
                        <h5 class="subtitle">Mobile Number</h5>
                        <ul class="list-unstyled">
                            <li>+90 (535) 415 2865</li>
                        </ul>
                    </div>
                </div>
                <div class="row" data-animate="fadeIn" data-delay="300">
                    <div class="col-xs-12 col-sm-auto">
                        <svg>
                            <use xlink:href="@Url.Content("~/Portal/img/sprite.svg#mail")" />
                        </svg>
                    </div>
                    <div class="col">
                        <h5 class="subtitle ">Email</h5>
                        <a href="mailto:info@tamtech.solutions">info@tamtech.solutions</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <h5 class="subtitle mb-4">Contact form</h5>

