@section scripts{
    <script src="~/Portal/js/slider.min.js"></script>
    <div class="modal fade" id="ContactModel" tabindex="-1" role="dialog" aria-labelledby="ContactModelLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-body p-5">
                    <p> Dear  <strong class="customer_name"></strong>, thanks for reaching out! </p>
                    <p> We have received your message and would like to thank you for writing to us. If it's urgent, You can also use the mobile number listed below to talk to us.</p>
                    <p>
                        Mobile No. <span dir="ltr" style="font-family:tahoma">+90 535 415 28 65</span>
                    </p>
                    <small>Have a great day!</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

