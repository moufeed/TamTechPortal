                    <div class="form-group">
                        <input type="text" class="form-control form-control-lg" placeholder="name" name="Name" />
                    </div>
                    <div class="from-group form-row">
                        <div class="col-sm mb-xs" data-animate data-delay="100">
                            <input type="tel" class="form-control form-control-lg" placeholder="phone" name="Mobile" id="phone" />
                        </div>
                        <div class="col-sm" data-animate data-delay="200">
                            <input type="email" class="form-control form-control-lg" placeholder="email" name="Email" id="email">
                        </div>
                    </div>
                    <div class="form-group mt-3" data-animate data-delay="300">
                        <textarea cols="30" rows="5" class="form-control" placeholder="message" name="Message"></textarea>
                    </div>
                    <div class="form-group" data-animate data-delay="400">
                        <button class="btn d-flex btn-send align-items-center">
                            <span>send</span>
                            <div class="lds-spinner d-none">
                                <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid">
