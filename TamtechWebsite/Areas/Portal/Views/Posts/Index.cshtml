@model SectionContainerDto
@{

    if (Model.SectionInfo != null)
    {
        ViewData["pageTitle"] = "";
        ViewData["Title"] = Model.SectionInfo.Title;
        ViewData["pageTitle"] = Model.SectionInfo.Title;
    }
    else
    {
        ViewData["pageTitle"] = "";
        ViewData["Title"] = Localizer["Blog"];
        ViewData["pageTitle"] = Localizer["Blog"];
    }

    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content("~/portal/img/headers/blog.jpg");
}
<partial name="~/Areas/Portal/Views/Shared/partials/_PagesHeader.cshtml" model="ViewData" />



<section class="btn-login section-content">
    <div class="container">
        <div class="row justify-content-bettwen">
            <div class="col-md-8">
                <if include-if="Model.Posts != null && Model.Posts.Count > 0">
                    <div class="blog-list">
                        @foreach (PostDto post in Model.Posts)
                        {
                            <article class="blog-item">
                                <div class="blog-image">
                                    <if include-if="string.IsNullOrEmpty(post.MainImage)">
                                        <img src="~/Portal/img/empty.jpg" class="img-fluid" />
                                    </if>
                                    <if exclude-if="string.IsNullOrEmpty(post.MainImage)">
                                        <img src="@post.MainImage" alt="@post.Title" class="img-fluid" />
                                    </if>
                                </div>

                                <div class="meta">
                                    <small>
                                        <i class="fi fi-calendar"></i> @post.CreatedDate.ToShortDateString()
                                    </small>
                                    <small>
                                        <i class="fi fi-folder"></i>
                                        <a href="@Url.Action("s","posts",new{slug=$"{@post.SectionSlug.Trim('/')}"}).Replace("%2F", "/")">@post.Section</a>
                                    </small>
                                </div>

                                @{string slug = @post.SectionSlug.Trim('/');}
                                <h5 class="title"> <a href="@Url.Action("p","Posts",new{slug=$"{@slug}/{@post.Slug}"}).Replace("%2F", "/")">@post.Title</a></h5>

                                <div class="text mt-3 mb-1">
                                    @post.Summary
                                </div>
                                <a href="@Url.AdminUrl("p","Posts",new{slug=$"{@slug}/{@post.Slug}"}).Replace("%2F", "/")" class=" px-0 btn btn-link">
                                    @Localizer["read_more"] <i class="fi fi-next"></i>
                                </a>
                            </article>
                        }
                    </div>
                    @*<partial name="_pagination" model="Model" />
        @Html.Partial("_pagination.cshtml", @Model)*@
                </if>
            </div>
            <div class="col-md-4">
                @if (Model.Sections != null && Model.Sections.Count > 0)
                {
                    <div class="sections-list widget">
                        <h4 class="widget-title"><strong>@Localizer["sections"]</strong></h4>
                        <sections-list sections="Model.Sections"
                                       action-name="s"
                                       controller-name="Posts"></sections-list>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

 

