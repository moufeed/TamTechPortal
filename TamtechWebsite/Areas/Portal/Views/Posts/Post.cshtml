@model PostDto
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";

    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "Edit";
}
@using System.Text;


<partial name="_PostHeader.cshtml" model="Model" />


<section class="section-content post-section pt-5">
    <div class="container">
        <div class="row">
            <div class="col">
                <div class="blog-content">
                    <div class="mb-5">
                        @Html.Raw(Model.Content)
                    </div>
                </div>

                
                <div class="post-block mt-5 mb-4 post-share">

                    <h4 class="mb-3">@Localizer["share_this_post"]</h4>
                     
                    <partial name="~/Areas/Portal/Views/Shared/utilities/_shareBar.cshtml"  />

                </div> 
            </div>

            @*<div class="col-lg-3 col-md-3 col-xs-12">

                @if (ViewBag.Sections != null && ViewBag.Sections.Count > 0)
                {
                <div class="categories-list widget">
                   
                    <header class="title-border-bottom">
                        <h3>
                            <span>@Localizer["sections"]</span>
                        </h3>
                    </header>
                    <sections sections="ViewBag.Sections"
                              class-name="SectionsList"
                              action-name="s"
                              controller-name="Posts"></sections>
                </div>
                }

            </div>*@
        </div>
    </div>
</section>
