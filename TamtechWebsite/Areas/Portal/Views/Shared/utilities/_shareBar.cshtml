    @inject Microsoft.AspNetCore.Http.IHttpContextAccessor accessor
@{
    Uri GetAbsoluteUri()
    {

        UriBuilder uriBuilder = new UriBuilder();
        uriBuilder.Scheme = accessor.HttpContext.Request.Scheme;
        uriBuilder.Host = accessor.HttpContext.Request.Host.Host;
        uriBuilder.Path = accessor.HttpContext.Request.Path.ToString();
        uriBuilder.Query = accessor.HttpContext.Request.QueryString.ToString();
        return uriBuilder.Uri;
    }

    var url = GetAbsoluteUri();
}
