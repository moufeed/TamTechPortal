
 <header class="main_header ">
        <div class="container">
            <div class="row justify-content-between align-items-center no-gutters">
                <div class="col-12 col-lg-auto">
                    <a href="@Url.Action("index","home")"><img src="~/Portal/img/logo.png" class="main-logo" alt="tamtech logo"></a>
                       <div class="d-md-none mobile-bar">
                            <a href="@Url.AdminUrl("request","home",new { Area ="portal"})" class="btn_request_quote">
                                    @Localizer["request"]
                            </a>
                    <button class="navbar-toggler" 
                        type="button" data-toggle="collapse" 
                        data-target="#mainnavbar" 
                        aria-controls="mainnavbar" 
                        aria-expanded="false" aria-label="Toggle navigation">
                            <i class="fas fa-bars"></i>
                        </button>
                       
                       </div>

                        <a href="@Url.AdminUrl("request","home",new { Area ="portal"})" class="btn-tablet btn btn-outline-orange request_quote mx-2 d-none d-md-inline d-lg-none">
                                @Localizer["request"]
                        </a>
                </div>
                <div class="col-12 col-lg-auto">
                    <nav class="navbar navbar-expand-md main-navbar">
                        <div class="collapse navbar-collapse" id="mainnavbar">
                            <bs4-navigation List-class="flip"></bs4-navigation>
                            <div class="my-2 my-lg-0 d-none d-lg-inline">
                                <a href="@Url.AdminUrl("request","home",new { Area ="portal"})" class="btn btn-outline-orange request_quote mx-2">
                                    @Localizer["request"]
                                </a>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
</header>




    