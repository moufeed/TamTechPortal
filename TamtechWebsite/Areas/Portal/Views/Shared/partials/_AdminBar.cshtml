@using IdentityServer4.Extensions
@{
    var controller = ViewContext.RouteData.Values["Controller"].ToString();
    var action = ViewContext.RouteData.Values["Action"].ToString();

    string name = null;
    if (!true.Equals(ViewData["signed-out"]))
    {
        name = Context.User?.GetDisplayName();
    }
}


@if (!string.IsNullOrWhiteSpace(name))
{
    <div class="adminbar bg-dark text-white">
        <div class="container-fluid">
            <div class="row justify-content-between align-items-center">
                <div class="col-auto">
                    <a asp-area="Admin" asp-action="Index" asp-controller="Home" target="_blank" class="text-white pl-4">
                        <i class="fa fa-tachometer" aria-hidden="true"></i>@Localizer["Dashboard"]
                    </a>
                </div>
                <div class="col-auto">
                    <div class="d-flex">
                        @if (ViewBag.ItemId != null && ViewBag.Action != null)
                        {
                            string act = ViewBag.Action;

                            <a href="@Url.Action(act , controller , new { Area="admin" ,id= ViewBag.ItemId })" class="btn btn-link text-white">@Localizer["edit"]</a>
                        }

                        <div class="dropdown">
                            <button class="btn btn-link dropdown-toggle text-white"
                                    type="button" id="dropdownMenuButton"
                                    data-toggle="dropdown"
                                    aria-haspopup="true" aria-expanded="false">
                                @name
                            </button>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                                 <a asp-area="identity" asp-action="changepassword" asp-controller="auth" class="dropdown-item"><i class="fa fa-key pull-right flip-dir"></i> @Localizer["change_password"]</a> 
                                <a asp-area="identity" asp-action="Logout" asp-controller="Account" class="dropdown-item"><i class="fa fa-sign-out pull-right flip-dir"></i>@Localizer["Log_Out"] </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

}



