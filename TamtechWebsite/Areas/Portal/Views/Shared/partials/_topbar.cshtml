    <nav class="header-nav-top ">
        <ul class="nav nav-pills">
            <li class="nav-item ">
                <a href=""> <i class="fa fa-envelope" aria-hidden="true"></i> @Localizer["mail_Us"]</a>
            </li>
            <li class="nav-item">
                <span class="ws-nowrap"><i class="fa fa-phone"></i> +9053533333</span>
            </li>
        </ul>
    </nav>
