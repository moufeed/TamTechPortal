@{
    string _lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var controller = ViewContext.RouteData.Values["Controller"].ToString();
    var action = ViewContext.RouteData.Values["Action"].ToString();
    var routeValues = ViewBag.LanguageTabsRouteValues != null ? (Microsoft.AspNetCore.Routing.RouteValueDictionary)ViewBag.LanguageTabsRouteValues : new Microsoft.AspNetCore.Routing.RouteValueDictionary(); ;
    routeValues.Add("culture", _lang);
}

<div class="main_topbar">
    <div class="container">
        <div class="row justify-content-between align-items-center">
            <div class="col-sm-auto">
                   <address >
                        @Localizer["Address_value"]
                   </address>
                   <a href="tel:00905354152865" dir="ltr" class="phonenumber">05354152865</a>
            </div>
            <div class="col-sm-auto">
                <div>
                    <if include-if="CultureConstants.CulturesList?.Count > 1">
                        <div class="languages-list">
                            <button class="btn btn-link btn-sm dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                @foreach (var culture in CultureConstants.CulturesList)
                                { 
                                    @if (_lang == culture.Lang)
                                    {
                                        @culture.Name
                                    }
                                }
                            </button>
                            <div class="dropdown-menu">
                                @foreach (var culture in CultureConstants.CulturesList)
                                {
                                    routeValues["culture"] = culture.Lang;
                                    @if (_lang != culture.Lang)
                                    {
                                        <a href="@Url.AdminUrl(action,controller,routeValues)" class="dropdown-item"> @culture.Name </a>
                                    }
                                }
                            </div>
                        </div>
                    </if>
                </div>
            </div>
        </div>
    </div>
</div>


 