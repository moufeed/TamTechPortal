
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="Content-Type" content="application/xhtml+html; charset=utf-8" />
    <title>@ViewData["Title"]</title>

    <link rel="shortcut icon" href="~/Portal/img/favicon.ico" type="image/x-icon">
    <link rel="icon" href="~/Portal/img/favicon.ico" type="image/x-icon">

    <link rel="stylesheet" href="~/Portal/css/style-ltr.min.css">
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }

</head>
<body>
    <header class="main_header d-sm-flex align-items-center" data-spy="affix" data-offset-top="197">
        <div class="container-fluid">
            <div class="row justify-content-between align-items-center">
                <div class="col-sm-auto xs-toolbar">
                    <img src="~/Portal/img/logo.png" class="logo" data-animate="fadeInDown" data-delay="50" alt="tamtech logo">
                    <button class="btn btn-light menu_btn  d-block d-sm-none" type="button" data-toggle="collapse" data-target="#navbarContent"
                            aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div class="col-sm-auto">
                    <nav class="navbar navbar-expand-sm navbar-light  p-0" data-animate="fadeInDown" data-delay="100">
                        <div class="collapse navbar-collapse" id="navbarContent">
                            <ul class="navbar-nav ml-auto justify-content-end">
                                <li class="nav-item active">
                                    <a class="nav-link " href="#home">Home </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#services">What We Do</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#products">Products</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link btn-started" href="#offers">Get Started</a>
                                </li>
                            </ul>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>




    @RenderBody()





    <footer class="main-footer">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col" data-animate="fadeIn" data-delay="100">
                    <p>Copyright © 2018 TamTech</p>
                </div>
                <div class="col-auto" data-animate="fadeIn" data-delay="200">
                    <nav class="d-flex socialnav">
                       
                        <a href="https://www.linkedin.com/company/tamtechsolutions/">
                            <svg>
                                <use xlink:href="@Url.Content("~/Portal/img/sprite.svg#linkedin-logo")" />
                            </svg>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </footer>


    <script src="~/Portal/js/script.min.js"></script>
    <script src="~/Portal/js/slider.min.js"></script>

    @RenderSection("Scripts", required: false)


    <a href="#" class="back-to-top">
        <svg viewBox="0 0 32.634 32.634">
            <path d="M16.317,32.634c-0.276,0-0.5-0.224-0.5-0.5V0.5c0-0.276,0.224-0.5,0.5-0.5s0.5,0.224,0.5,0.5v31.634
            C16.817,32.41,16.594,32.634,16.317,32.634z" />
            <path d="M28.852,13.536c-0.128,0-0.256-0.049-0.354-0.146L16.319,1.207L4.135,13.39c-0.195,0.195-0.512,0.195-0.707,0
            s-0.195-0.512,0-0.707L15.966,0.146C16.059,0.053,16.186,0,16.319,0l0,0c0.133,0,0.26,0.053,0.354,0.146l12.533,12.536
            c0.195,0.195,0.195,0.512,0,0.707C29.108,13.487,28.98,13.536,28.852,13.536z" />
        </svg>
    </a>
</body>
</html>






