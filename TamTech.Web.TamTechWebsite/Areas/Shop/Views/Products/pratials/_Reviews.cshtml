<section class="reviews-wrapper">
    <h3 class="reviews-title"><strong>Customer reviews</strong></h3>
   
    <div class="review">
                
            <div class="review-header d-flex justify-content-between  align-items-start">
                <div class="profile clerfix">
                    <div class="profile-img">
                        <img src="~/shop/img/avatar.png" alt="">
                    </div>
                    <div class="profile-content">
                            <strong> Eddie K. Jones </strong>
                            <span>September 14, 2017</span>
                    </div>
                </div>
                <div class="review-rating">
                        <span>
                            @for (var i =1 ; i <= 5; i++){
                                @if(i < 4){
                                    <i class="fa fa-star active" aria-hidden="true" ></i>
                                }else{
                                    <i class="fa fa-star" aria-hidden="true"></i>
                                }
                            }
                        </span>
                    </div>
            </div>

        <div class="review-body">
