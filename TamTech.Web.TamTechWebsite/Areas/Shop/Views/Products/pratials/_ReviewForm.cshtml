  <form  class="form form-review" id="reviewForm" >
            <div class="form-row">
                <div class="col-sm">
               <label for="Name">Your name : 
                   <sup class="fa fa-asterisk text-danger fz-8"></sup></label>
                  <input type="text" class="form-control form-control-lg" name="Name" required>
                </div>
                <div class="col-sm">
                <label for="Name">Your Email : 
                    <sup class="fa fa-asterisk text-danger fz-8"></sup>
                </label>
                   <input type="email" class="form-control form-control-lg"  name="Email" required>
                </div>
            </div>
        
        <div class="form-group mt-2">
            <label for="Name">Review Title:</label>
            <input type="text" class="form-control form-control-lg" >
        </div>
        <div class="form-group mt-2">
            <label for="Name">Review text:
                <sup class="fa fa-asterisk text-danger fz-8"></sup>
            </label>
             <textarea name="Review" id="" cols="30" rows="5"  class="form-control" required></textarea>
        </div>

        <div class="form-group">
                <div class="form-row">
                    <div class="col-sm">
                       <div class="d-flex justify-content-start align-items-center">
                            <label for="" class="my-0 mx-3">Rating</label>
                        <span class="rating">
                            <input type="radio" id="star5" name="rating" value="5" />
                            <label class = "full" for="star5" title="Awesome - 5 stars"></label>
                            <input type="radio" id="star4" name="rating" value="4" />
                            <label class = "full" for="star4" title="Pretty good - 4 stars"></label>
                            <input type="radio" id="star3" name="rating" value="3" />
                            <label class = "full" for="star3" title="Meh - 3 stars"></label>
                            <input type="radio" id="star2" name="rating" value="2" />
                            <label class = "full" for="star2" title="Kinda bad - 2 stars"></label>
                            <input type="radio" id="star1" name="rating" value="1" />
                            <label class = "full" for="star1" title="Sucks big time - 1 star"></label>
                        </span>
                       </div>
                    </div>
                    <div class="col-sm text-right">
                        <button type="submit" class="btn btn-outline-success px-4 btn-send">Send</button>
                    </div>
                </div> 
        </div>

    </form>