<div class="row products-view grid-view no-gutters">



@for(var i=1; i< 10; i++){
<div class="col-md-6 col-lg-4 pro-item">
<div class="product-box">
    <div class="product-ribbons">
        
       <a href="/Details" class="product-image d-flex justify-content-center align-items-center"> 
       <img src="~/shop/img/products/@(i).jpg" alt="prdouct image"> </a>


        <div class="product-action">
            @if(i % 2 == 0){
                <button class="btn btn-whitelist in-whitelist " data-toggle="tooltip" data-placement="top"  title="Remove From whitelist">
                    <i class="fa fa-heart-o" aria-hidden="true"></i>
                </button>

                 <button class="btn btn-compare inlist"  data-toggle="tooltip" data-placement="top"  title="Remove From Compare">
                   <i class="fa fa-exchange" aria-hidden="true"></i>
            </button>


            }else{
                 <button class="btn btn-whitelist" data-toggle="tooltip" data-placement="top"  title="Add to whitelist" onclick="$productManage.AddToWhitelist(12)">
                    <i class="fa fa-heart-o" aria-hidden="true"></i>
                </button>

                 <button class="btn btn-compare "  data-toggle="tooltip" data-placement="top"  title="Add To Compare" onclick="$productManage.AddToCompare(12,'/Shop/Products/compare')">
                   <i class="fa fa-exchange" aria-hidden="true"></i>
            </button>
            }
            

           
        </div>

        <div class="products-ribbons">
             <span class="ribbon new">New</span>
             <span class="ribbon offer">30%</span>
        </div>
    </div>

    <div class="pro-info">
        <div class="product-info">
            <a href="/shop/products/Details" class="title">
                Lightning Earphones,With Microphone Earbuds
            </a>
            <div class="prices d-flex justify-content-center">
                <span class="price">$317.00</span>
                <span class="old-price">$329.00</span>
            </div>
    </div>
    <div class="product-description">
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum repellendus esse, laborum iure quos placeat enim rerum officiis ex. Saepe atque nisi quasi assumenda neque expedita enim ratione omnis ab!
    </div>
    <div class="product-footer">
        <button class="btn addtocart" onclick="$productManage.AddToCart(12)">
               <i class="fa fa-shopping-basket" aria-hidden="true"></i>
               add to cart
        </button>
    </div>
    </div>

</div>


</div>
}

</div>