
<section class=" mt-4 section-related ">
    <div class="container realted-products">
        <h3 class="title title-bottom-border"> <strong>Related Products</strong></h3>
        <div class="row no-gutters" id="relatedProducts"> 
            
@for(var i=1; i< 10; i++){

<div class="product-box">
    <div class="product-ribbons">
       <a href="#" class="product-image d-flex justify-content-center align-items-center"> <img src="~/shop/img/products/@(i).jpg" alt="prdouct image"> </a>
        <div class="product-action">
          <button class="btn btn-whitelist" data-toggle="tooltip" data-placement="top"  title="Add to whitelist">
                    <i class="fa fa-heart-o" aria-hidden="true"></i>
                </button>

                 <button class="btn btn-compare "  data-toggle="tooltip" data-placement="top"  title="Add To Compare">
                   <i class="fa fa-exchange" aria-hidden="true"></i>
            </button>
        </div>

        <div class="products-ribbons">
             <span class="ribbon new">New</span>
             <span class="ribbon offer">30%</span>
        </div>
    </div>

    <div class="pro-info">
        <div class="product-info">
            <a href="#" class="title">
                Lightning Earphones,With Microphone Earbuds
            </a>
            <div class="prices d-flex justify-content-center">
                <span class="price">$317.00</span>
                <span class="old-price">$329.00</span>
            </div>
    </div>
      
    <div class="product-footer">
        <button class="btn addtocart">
               <i class="fa fa-shopping-basket" aria-hidden="true"></i>
               add to cart
        </button>
    </div>
    </div>

</div>
 
}
        </div>
    </div>
</section>

