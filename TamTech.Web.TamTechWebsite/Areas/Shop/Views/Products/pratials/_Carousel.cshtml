<div class="product-carousel">
    <div class="light-slider" id="productcarousel" data-left = '&#xf104;' data-right='&#xf105;'>
        @for(var i = 1; i<8; i++){
                <div class="item" data-thumb="@Url.Content($"~/shop/img/product/{i}.jpg")">
                    <img src="~/shop/img/product/@(i).jpg" class="img-fluid">
                </div>
            }
    </div>
</div>


