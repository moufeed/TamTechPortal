@model  UserModel
 
    @{ ViewData["Title"] = "Create";
     //   Layout = "~/Views/Shared/_Layout.cshtml";
    }


<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>User details</h3>
        </div>
        <div class="title_right text-right">
            <a asp-action="Index" class="btn btn-default"><span class="fa fa-chevron-left"></span>  Back to List</a>
            @*<a class="btn btn-default"><span class="fa fa-edit"></span>  Edit user</a>*@
        </div>
    </div>
</div>
    <section class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_content">

                    <div class="cleafix user_details">
                        <div class="user_image hidden">
                            <img src="@Model.ImageUrl" alt="">
                        </div>

                        <div class="user_info m-l5">
                            <header class="u_title p-y-2">
                                <h3 class="display-inline">
                                    @Model.UserName
                                    @if (Model.MobileNumberConfirmed)
                                    {
                                        <small class="c-dark-green block">Mobile number Confirmed</small>
                                    }
                                    else
                                    {
                                        <small class="c-dark-red d-block">Mobile number not confirmed</small>
                                    }
                                </h3>
                                <div>
                                    @if (Model.IsBlocked)
                                    {<span class="c-red" id="UserStatus"><i class="fa fa-times-circle-o c-red"></i> Blocked</span>
                                    }


                                    else
                                    {<span class="c-green" id="UserStatus"><i class="fa fa-check"></i> Active</span>
                                    }
                                </div>

                            </header>
                            <hr  class="m-t2"/>
                            <div class="u_actions">
                                <a class="btn btn-send" href="/Admin/Email/new/@Model.UserName/@Model.Email">
                                    <i class="fa fa-envelope-open-o"></i>
                                    Send Email
                                </a>
                                <a class="btn btn-send" href="/Admin/Sms/new/@Model.UserName/@Model.MobileNumber.Replace("+" , "00")">
                                    <i class="fa fa-comment "></i>
                                    Send Sms
                                </a>

                                @if (Model.IsBlocked)
                                {
                                    <a class="btn unblock toggleblock"
                                       data-unblock-url="@ViewBag.UnlockEndpointUrl"
                                       data-block-url="@ViewBag.BlockEndpointUrl"
                                       data-username="@Model.UserName"
                                       data-id="@Model.Id" data-status="true">unblock user</a>
                                }
                                else
                                {
                                    <a class="btn block toggleblock"
                                       data-username="@Model.UserName"
                                       data-unblock-url="@ViewBag.UnlockEndpointUrl"
                                       data-block-url="@ViewBag.BlockEndpointUrl"
                                       data-id="@Model.Id"
                                       data-status="false">block user</a>
                                }

                            </div>
                            <hr />
                            <div class=" p-l3 m-t3">
                                <h4 class="c-blue"><strong>User Information</strong></h4>
                                <ul class="list-unstyled u_information">
                                    
                                    <li>
                                        <strong>Username:</strong>
                                        <span>@Model.UserName</span>
                                        
                                    </li>

                                    <li>
                                        <strong>phone:</strong>
                                        <span>@Model.MobileNumber</span>
                                       
                                    </li>

                                    <li>
                                        <strong>Email:</strong>
                                        <span>@Model.Email</span>
                                       
                                    </li>

                                    <li class="hidden">
                                        <strong>Gender:</strong>
                                        <span>@Model.Gender</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</section>