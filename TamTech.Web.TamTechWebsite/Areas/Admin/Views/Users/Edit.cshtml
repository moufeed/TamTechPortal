 

@{
    @using AdminPanelWeb.Models;
    @model CreateUserVM;
    ViewData["Title"] = "Edit";
}



<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>Edit user</h3>
        </div>
        <div class="title_right text-right">
            <a asp-action="Index" class="btn btn-default"><span class="fa fa-chevron-left"></span>  Back to List</a>
        </div>
    </div>
</div>

<section class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_content">

                @using (Html.BeginForm("Edit", "Users", FormMethod.Post,
                               new
                               {
                                   enctype = "multipart/form-data",
                                   @class = "form-horizontal forn-new form-label-left m-t5",
                                   id = "EditUserForm"
                               }))

                {
                    @Html.ValidationSummary(true, "", new { @class = "  col-md-3 col-sm-4 col-xs-12 " })
                    @Html.HiddenFor(m => m.Id)

                    <div class="clearfix">
                        <div class="col-sm-4 col-xs-12 col-md-3">
                            <div class="imagebox">
                                <img src="" alt="" id="imagePreview">
                            </div>
                            <div class="form-group from-file">
                                <input type="file" name="ImageUrl" id="avater" class="input-file" accept="image/*">
                                <label for="avater" class="btn btn-tertiary  ">
                                    <span>Choose a Picture</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-sm-8 col-xs-12 col-md-9">
                            <div class="form-group clearfix ">
                                @Html.Label("Name", "Name :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            <div class="form-group clearfix">
                                @Html.Label("Username", "Username :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            <div class="form-group clearfix">
                                @Html.Label("Email", "Email Address :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "Email" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger  " })
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                @Html.Label("Password", "Password :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.Password("Password", null, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger  " })

                                </div>
                            </div>

                            <div class="form-group clearfix">
                                @Html.Label("ConfirmPasswoord", "Confirm Passwoord :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.Password("ConfirmPasswoord", null, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.ConfirmPasswoord, "", new { @class = "text-danger  " })

                                </div>
                            </div>

                            <div class="form-group clearfix">
                                @Html.Label("Phone", "Phone :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", @type = "tel", required = "required" })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            <div class="form-group">

                                @Html.Label("Gender", "Gender :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    <div class="btn-group" data-toggle="buttons">
                                        <label class="btn btn-default">
                                            @Html.RadioButtonFor(m => m.Gender, "male") &nbsp; Male &nbsp;
                                        </label>
                                        <label class="btn btn-default">
                                            @Html.RadioButtonFor(m => m.Gender, "female") Female
                                        </label>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger  " })
                                </div>
                            </div>
                            <div class="form-group clearfix">
                                @Html.Label("Role", "Role :", new { @class = "control-label col-md-3 col-sm-4 col-xs-12 " })
                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    @*@Html.DropDownList("Role",
                                        new SelectList(Enum.GetValues(typeof(RolesEnum))),
                                        "Select Role",
                                        new { @class = "form-control" })*@

                                    @Html.DropDownList("Roles",
                                   new SelectList(ViewBag.Roles,"Name", "Name"),
                                       "Select Role",
                                       htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger  ", required = "required" })
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-3 col-sm-offset-4 col-sm-6 col-xs-12 ">
                                    <input type="submit" class="btn btn-success p-x-5" value="Create">
                                </div>
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>
</section>
