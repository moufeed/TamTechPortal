@model  ProductFormVM
@{
    ViewData["Title"] = "Form";

    int index = 0, attrIdx = 0, imageIndex = 0, dtab = 0, comb = 0;
}
@{ string target = ViewData["FormAction"].ToString(); }
@using (Html.BeginForm(target, "Products", FormMethod.Post,
new
{
   enctype = "multipart/form-data",
   @class = "form-horizontal forn-new form-label-left m-t5",
   id = "ProductForm"
}))

{
    <div class="clearfix">
        <div class="page-title">
            <div class="title_left">
                <h3>@ViewData["PageTitle"]</h3>
            </div>
            <div class="title_right text-right">


                <a asp-action="Index" class="btn btn-default">
                    <span class="fa fa-chevron-left"></span> Back to List
                </a>
                <button type="submit" name="save" class="btn btn-success"><i class="fa fa-save"></i> Save </button>
                <button type="submit" name="save-continue" class="btn  btn-info">
                    <i class="fa fa-floppy-o"></i>
                    Save and Continue Edit
                </button>
                @if (ViewBag.isUpdate)
                {
                <button type="button" class="btn  btn-danger delete-product" data-redirection>
                    <i class="fa fa-trash-o"></i>
                    Delete
                </button>
                }
                    
                </div>
        </div>
    </div>



    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <header class="header_bar clearfix">
                    <div class="pull-left">
                        <ul class="nav nav-tabs navs-line" role="tablist">
                            <li role="presentation" class="active"><a href="#information" aria-controls="information" role="tab" data-toggle="tab">Product info</a></li>
                            <li role="presentation"><a href="#Specifications" aria-controls="Specifications" role="tab" data-toggle="tab">Product Specifications</a></li>
                            <li role="presentation"><a href="#Description" aria-controls="Description" role="tab" data-toggle="tab">Product Description</a></li>
                            <li role="presentation"><a href="#images" aria-controls="images" role="tab" data-toggle="tab">Product Pictures</a></li>
                            @if (ViewBag.isUpdate)
                            {
                                <li role="presentation"><a href="#Attributes" aria-controls="Attributes" role="tab" data-toggle="tab">Product Attributes</a></li>

                            }
                        </ul>
                    </div>
                    @if (ViewBag.isUpdate)
                    {
                        <div class="pull-right">
                            <span class="toggle_span">
                                <span>unpublish / publish </span>
                                @Html.CheckBoxFor(m => m.Published, new { @class = "toggle_switch", id = "publish_product" })
                            </span>
                        </div>
                    }
                </header>
                <div class="x_content p-t5">

                    @Html.ValidationSummary(true, "", new { @class = "  col-md-3 col-sm-4 col-xs-12 " })
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade  in  active" id="information">
                            @{
                                await Html.RenderPartialAsync("_Form_information_tab");
                            }
                        </div>
                        <div role="tabpanel" class="tab-pane fade" id="Specifications">
                            @{
                                var Specifications_tab = Html.Partial("_Form_Specifications_tab");
                                index = (int)this.ViewContext.HttpContext.Items["index"];
                            }
                            @Specifications_tab
                        </div>

                        <div role="tabpanel" class="tab-pane fade " id="images">
                            @{
                                var Images_tab = Html.Partial("_Form_Images_tab");
                                imageIndex = (int)this.ViewContext.HttpContext.Items["image_index"];
                            }
                            @Images_tab
                        </div>


                        <div role="tabpanel" class="tab-pane fade " id="Description">
                            @{
                                var _description_tab = Html.Partial("_Form_Description_tab");
                                dtab = (int)this.ViewContext.HttpContext.Items["dtab"];
                            }
                            @_description_tab
                        </div>





                        @if (ViewBag.isUpdate)
                        {
                            <div role="tabpanel" class="tab-pane fade" id="Attributes">
                                @{
                                    var Attributes_tab = Html.Partial("_Form_Attributes_tab");
                                    attrIdx = (int)this.ViewContext.HttpContext.Items["attrIdx"];
                                    comb = (int)this.ViewContext.HttpContext.Items["combination"];
                                }
                                @Attributes_tab
                            </div>

                        }

                    </div>
                    <div class="form-footer text-right">
                        <hr>

                        <a asp-action="Index" class="btn btn-default pull-left">
                            <span class="fa fa-chevron-left"></span> Back to List
                        </a>
                        <button type="submit" name="save" class="btn btn-success"><i class="fa fa-save"></i> Save </button>
                        <button type="submit" name="save-continue" class="btn  btn-info">
                            <i class="fa fa-floppy-o"></i>
                            Save and Continue Edit
                        </button>
                        @if (ViewBag.isUpdate)
                        {
                            <button type="button" class="btn  btn-danger delete-product" data-redirection>
                                <i class="fa fa-trash-o"></i>
                                Delete
                            </button>
                        }

                    </div>

                </div>
            </div>
        </div>
    </div>
}




<!-- combination Modal -->
<div class="modal fade " id="combinationModal" tabindex="-1" role="dialog" aria-labelledby="combinationModalLabel" aria-hidden="true">
    <div class="fiexd-flex-center">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Select new combination and enter details below </h4>
                </div>

                <form class="form" id="product_cobinations">
                    <div class="modal-body overflow ">

                        <div class="atrributes_selects_box ">
                            <div class="lds-ripple"><div></div><div></div></div>
                        </div>

                        <div class="form-group clearfix">
                            <label class="control-label col-md-3 col-sm-4"> Stock quantity </label>
                            <div class="col-md-9 col-sm-8 col-xs-12">
                                <input type="number" step="1" name="quantity" class="form-control" min="0" value="0" />
                            </div>
                        </div>
                        <div class="form-group clearfix">
                            <label class="control-label col-md-3 col-sm-4"> Sku </label>
                            <div class="col-md-9 col-sm-8 col-xs-12">

                                <input type="text" id="pro_sku" class="form-control ignore" disabled />
                                <div class="combSkUBox">
                                    <input type="text" name="sku" id="combSkU" class="form-control" required />
                                </div>
                            </div>
                        </div>

                        <div class="form-group clearfix">
                            <label class="control-label col-md-3 col-sm-4"> price </label>
                            <div class="col-md-9 col-sm-8 col-xs-12">
                                <input type="number" step="any" name="price" class="form-control" id="combination_price" min="0" value="0" />
                            </div>
                        </div>

                        <div class="form-group clearfix">
                            <label class="control-label col-md-3 col-sm-4"> Discount  price </label>
                            <div class="col-md-9 col-sm-8 col-xs-12">
                                <input type="number" step="any" name="discountprice" class="form-control" id="discount_price" min="0" value="0" />
                            </div>
                        </div>


                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn  btn-link link-red  close-link" data-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-save" id="saveCombination">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>








@section Styles{
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}

@section Scripts{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/Admin/lib/select2/dist/js/select2.min.js"></script>

    <script src="~/Admin/lib/typeahead.js/dist/typeahead.jquery.js"></script>
    <script src="~/Admin/js/validator.min.js"></script>
    <script type="text/javascript">

        $('.select_picker').select2();

        var pid = "@Model.Id",
             idx =  @index ,
             hints = [],
             attrIdx = @attrIdx,
             img_index =  @imageIndex,
             dtab = @dtab,
             comb = @comb,
             PSKU = "@Model.SKU";

    </script>
    <script src="~/Admin/js/product.min.js"></script>

    <script src="~/Admin/lib/tinymce/tinymce.js"></script>

    <script>
        tinymce.init({
            selector: '#FullDescription',
            branding: false,
            theme: 'modern',
            height: 300,
            plugins: ['advlist autolink link image lists charmap print preview hr anchor pagebreak spellchecker ',
                'searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media nonbreaking',
                'save table contextmenu directionality emoticons template paste textcolor'],
            toolbar: 'insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | print preview media fullpage | forecolor backcolor emoticons'
        });</script>


}