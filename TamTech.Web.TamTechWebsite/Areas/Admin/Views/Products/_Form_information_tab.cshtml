        </div>
    </div>*@
<hr />
<div class="form-group clearfix">
    @Html.Label("Price", "Price :", new { @class = "control-label col-md-3 col-sm-3 col-xs-12 " })
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextBoxFor(m => m.Price, new { @class = "form-control price-group", type = "number", step = "any" , min="0" })
        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger invalid_field" })
    </div>
</div>
<div class="form-group clearfix">
    @Html.Label("DiscountPrice", "Discount Price :", new { @class = "control-label col-md-3 col-sm-3 col-xs-12 " })
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextBoxFor(m => m.DiscountPrice, new { @class = "form-control price-group", type = "number", step = "any", min = "0" })
        @Html.ValidationMessageFor(m => m.DiscountPrice, "", new { @class = "text-danger invalid_field" })
    </div>
</div>
<hr />
<div class="form-group clearfix">
    @Html.Label("StockQuantity", "Quantity :", new { @class = "control-label col-md-3 col-sm-3 col-xs-12 " })
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control ignore", type= "number" ,
       min = "0", step = "1" })
        @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger invalid_field" })
    </div>
</div>

<div class="form-group clearfix">
    @Html.Label("MaximumCartQuantity", "Maximum Cart Quantity :", new { @class = "control-label col-md-3 col-sm-3 col-xs-12 " })
    <div class="col-md-8 col-sm-8 col-xs-12">
        @Html.TextBoxFor(m => m.MaximumCartQuantity, new { @class = "form-control ignore", type= "number" ,
       min = "0", step = "1" })
        @Html.ValidationMessageFor(m => m.MaximumCartQuantity, "", new { @class = "text-danger invalid_field" })
    </div>
</div>
<hr />
<div class="form-group clearfix">

    <label for="MaximumCartQuantity" class="control-label col-md-3 col-sm-3 col-xs-12 ">Manufacturer :</label>

    <div class="col-md-8 col-sm-8 col-xs-12">
        <div class="clerfix" style="position:relative">
            <div class="col-md-4 col-sm-4 col-xs-12 p-x-0">
                <select asp-for="Brand"
                        asp-items="ViewBag.Brands"
                        class="form-control select_picker"
                        data-live-search="true"
                        data-style="btn-select"></select>
                <span asp-validation-for="Brand" class="text-danger invalid_field"></span>
            </div>

            <label for="Categories" class="control-label col-md-3 col-md-offset-1 col-sm-4 col-xs-12"> Categories :</label>
            <div class="col-md-4 col-sm-4 col-xs-12 p-x-0">
                <select asp-for="Categories"
                        name="Categories" id="Categories"
                        asp-items="ViewBag.categories"
                        class="form-control select_picker"
                        multiple="multiple"
                        data-live-search="true"
                        size="5"
                        data-style="btn-select"></select>
                <span asp-validation-for="Categories" class="text-danger invalid_field"></span>
            </div>
        </div>
    </div>
</div>


<div class="form-group clearfix">
    <label for="IsShipEnabled" class="control-label col-md-3 col-sm-3 col-xs-12 ">Requires Shipping</label>
    <div class="col-md-8 col-sm-8 col-xs-12">
        <div class="clerfix">
            <div class="col-md-4 col-sm-4 col-xs-12 p-x-0">
                <input type="checkbox" asp-for="IsShipEnabled" name="IsShipEnabled" id="Shipping" class="toggle_switch" />
                <span asp-validation-for="IsShipEnabled" class="text-danger invalid_field"></span>
            </div>
            <div class="col-md-8 col-sm-8 col-xs-12 p-x-0">

                <label for="IsFreeShipping" class="control-label col-md-3 col-md-offset-1 col-sm-4 col-xs-12">Free Shipping</label>

                <div class="col-md-4 col-sm-4 col-xs-12 p-x-0">
                    @if (Model.IsShipEnabled)
                    {
                        <input type="checkbox" asp-for="IsFreeShipping" name="IsFreeShipping" id="IsFreeShipping" class="toggle_switch " />
                    }
                    else
                    {
                        <input type="checkbox" asp-for="IsFreeShipping" name="IsFreeShipping" id="IsFreeShipping" class="toggle_switch " disabled />
                    }


                    <span asp-validation-for="IsFreeShipping" class="text-danger invalid_field"></span>
                </div>

            </div>
        </div>
    </div>
</div>

<hr />

@{ string disabledInput = Model.IsShipEnabled ? "" : "disabled='disabled' "; }
<div class="form-group clearfix shipping_inputs ">
    <div class="col-md-3 col-sm-3 col-xs-12">

        <label for="Weight" class="m-b3">Weight</label>
        <div class="input-group">
            @if (Model.IsShipEnabled)
            {<input type="number" class="form-control ignore" id="Weight" step=".01" name="Weight" asp-for="Weight"> }
            else
            { <input type="number" class="form-control ignore" id="Weight" step=".01" name="Weight" asp-for="Weight" disabled>}
            <div class="input-group-addon">gram</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12">
        <label for="Length" class="m-b3">Length</label>
        <div class="input-group">
            @if (Model.IsShipEnabled)
            {<input type="number" class="form-control ignore" id="Length" step=".01" name="Length" asp-for="Length"> }
            else
            { <input type="number" class="form-control ignore" id="Length" step=".01" name="Length" asp-for="Length" disabled>}
            <div class="input-group-addon">Millimeter</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12">
        <label for="Weight" class="m-b3">Width</label>
        <div class="input-group">
            @if (Model.IsShipEnabled)
            {<input type="number" class="form-control ignore" id="Width" step=".01" name="Width" asp-for="Width"> }
            else
            { <input type="number" class="form-control ignore" id="Width" step=".01" name="Width" asp-for="Width" disabled>}

            <div class="input-group-addon">Millimeter</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12">
        <label for="Height" class="m-b3">Height</label>
        <div class="input-group">
            @if (Model.IsShipEnabled)
            {<input type="number" class="form-control ignore" id="Height" step=".1" name="Height" asp-for="Height"> }
            else
            { <input type="number" class="form-control ignore" id="Height" step=".1" name="Height" asp-for="Height" disabled>}
            <div class="input-group-addon">Millimeter</div>
        </div>
    </div>

</div>