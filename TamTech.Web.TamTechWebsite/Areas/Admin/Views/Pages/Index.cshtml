@model List< Page>

@{
    ViewData["Title"] = "Pages";
}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>Pages <small></small></h3>
        </div>
        <div class="title_right text-right">
            <a asp-action="CreateHtmlPage" 
               class="btn btn-default btn-add-new">New html Page</a>
            <a asp-action="CreateSectionsPage" 
               class="btn btn-default  btn-add-new">New Sections Page</a>
        </div>
    </div>
</div>




<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel p-x-0">
            <div class="x_content">
                <div class="table-responsive datatable">
                    <table class="table table-middle table-striped" id="pagesTable">
                        <thead>
                            <tr>
                                <th width="50" class="text-center">No.</th>
                                <th>Title</th>
                                @*<th>Author</th>*@
                                <th>Created Date</th>
                                <th>Modified Date</th>
                                <th>Type</th>
                                <th width="150" class="text-center">Visibility</th>
                                <th width="200" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>

                            @{int i = 1;}
                            @foreach (var item in Model)
                            {
                                <tr id="tr-@item.Id">
                                    <td class="text-center">@i</td>
                                    <td>@item.Title</td>
                                    @*<td>@item.CreatorUserId</td>*@
                                    <td>@item.CreatedDate</td>
                                    <td>@item.ModifiedDate</td>
                                    <td>
                                        @((item.Type == (int)PageTypeEnum.Sections) ?
                                                      PageTypeEnum.Sections.ToString() : PageTypeEnum.Html.ToString())
                                    </td>
                                    <td class="text-center">
                                        @if (@item.Published)
                                        {

                                            <a id="pubunpub-@i"
                                               data-toggle="tooltip"
                                               data-placement="top"
                                               data-id="@item.Id"
                                               data-status="true"
                                               title="publish"
                                               data-url="/Admin/Pages/Publish/@item.TypeEnum/@item.Id"
                                               class="btn btn-link-pup ptrue">
                                                <i class="fa fa-eye c-green"></i>
                                                <small>published</small>
                                            </a>

                                        }
                                        else
                                        {

                                            <a  id="pubunpub-@i"
                                               data-toggle="tooltip"
                                               data-placement="top"
                                               data-id="@item.Id"
                                               title="unpublished"
                                                 
                                               data-url="/Admin/Pages/Publish/@item.TypeEnum/@item.Id"
                                               class="btn btn-link-pup ">
                                                <i class="fa fa-eye-slash c-red"></i>
                                                <small>unpublished</small>
                                            </a>

                                           
                                        }
                                    </td>
                                    <td>
                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="Details"
                                           asp-action="@item.TypeEnum.ToString()"
                                           asp-route-id="@item.Id"
                                           @*asp-route-type="@item.Type" *@
                                           class="btn btn-view"><i class="fa fa-eye "></i></a>

                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="Edit"
                                           asp-action="@(item.TypeEnum == PageTypeEnum.Html ? "EditHtmlPage" :"EditSectionsPage" )"
                                           asp-route-id="@item.Id"
                                           @*asp-route-type="@item.Type" *@
                                           class="btn btn-edit"><i class="fa fa-edit "></i></a>

                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           data-id="@item.Id" 
                                           title="Remove"
                                           data-url="/Admin/Pages/Delete/@item.TypeEnum/@item.Id"
                                           class="btn btn-remove"
                                           onClick="RemoveItem(Pagestable, this)"><i class="fa fa-times "></i></a>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>




@section Styles{
    <link href="~/Admin/lib/datatables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/Admin/lib/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/Admin/lib/datatables/media/js/dataTables.bootstrap.js"></script>

    <script>

    $(document).ready(function () {

        window.Pagestable = $('#pagesTable').DataTable({

         "language": {
            "emptyTable": "<div class='empty_table'> <i class='fa fa fa-exclamation-circle'></i><p>No data available in table</p></div>",
            "processing": "Loading..."
        },

        });

        });

        $(document).on('click','a[id^="pubunpub-"]',function(){

            let $el = $(this);
            let url = $el.data('url')
            let status = $el.data('status');
            $el.find('i').removeClass().addClass("fa fa-spinner fa-pulse");
            $.get(url,()=>{}).done(function(data){
                if( $el.hasClass('ptrue') ){
                     $el.removeClass('ptrue')
                     $el.attr('title' , 'unpublished');
                     $el.find('i').removeClass("fa-spinner fa-pulse").addClass("fa-eye-slash c-red");
                     $el.find('small').text('unpublished');
                     $notification.success("", "unpublished successfully", 2500, "fa fa-check")
                }else{
        
                    $el.addClass('ptrue')
                    $el.attr('title' , 'publish');
                    $el.find('i').removeClass("fa-spinner fa-pulse").addClass("fa-eye c-green");
                    $el.find('small').text('published');
                    $notification.success("", "published successfully", 2500, "fa fa-check")
                }
            })
        })
    </script>

}
  