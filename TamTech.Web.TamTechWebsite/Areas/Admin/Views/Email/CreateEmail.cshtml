@model EmailVM
@{
    ViewData["Title"] = "new email";
}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>New Mail <small></small></h3>
        </div>
        <div class="title_right text-right">
            @if (ViewBag.SpecificUser)
            {
                <a  OnClick="JavaScript: window.history.back(1); return false;"
                   class="btn btn-default"><span class="fa fa-chevron-left"></span>Back</a>
            }
            else
            {
                <a asp-action="Index"
                   class="btn btn-default"><span class="fa fa-chevron-left"></span>Back to List</a>
            }

        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel p-x-0">
            <div class="x_content">
                @{ string target = "Create"; }

                @using (Html.BeginForm(target, "Email", FormMethod.Post,
           new
           {
               enctype = "multipart/form-data",
               @class = "form-horizontal forn-new form-label-left m-t5",
               id = "EmailForm"
           }))

                {
                    @Html.ValidationSummary(true)

                   

                    <div class="form-group clearfix">
                        <label asp-for="Subject" class="control-label col-md-3 col-sm-3 col-xs-12 ">Subject :</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">
                            <input type="text" asp-for="Subject" class="form-control" required />
                            <span asp-validation-for="Subject" class="text-danger invalid_field"></span>
                        </div>
                    </div>
                    
                    <div class="form-group clearfix">
                        <label asp-for="Recipients" class="control-label col-md-3 col-sm-3 col-xs-12 ">Recipients :</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">

                            @if (ViewBag.SpecificUser)
                            {

                                <input type="hidden" name="Recipients" value="@ViewBag.email" />
                                <input type="text" value="@ViewBag.username / @ViewBag.email" disabled class="form-control" />

                                 
                            }
                            else
                            {
                                <select asp-for="Recipients"
                                        name="Recipients" id="Recipients"
                                        asp-items="ViewBag.UsersList"
                                        class="form-control select_picker"
                                        multiple="multiple"
                                        data-live-search="true"
                                        size="5"
                                        required
                                        data-style="btn-select"
                                        data-max-options="50"
                                        data-selected-text-format="count > 4"></select>
                                <span asp-validation-for="Recipients" class="text-danger invalid_field"></span>
                            }
                        </div>
                    </div>


                    <div class="form-group clearfix">
                        <label asp-for="Massage" class="control-label col-md-3 col-sm-3 col-xs-12 ">Massage :</label>
                        <div class="col-md-7 col-sm-5 col-xs-12">
                            <textarea asp-for="Massage" class="form-control" rows="12"></textarea>
                            <span asp-validation-for="Massage" class="text-danger invalid_field"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-7 col-md-offset-3 col-sm-offset-4 col-sm-6 col-xs-12 text-right">
                            <input type="submit" class="btn btn-success p-x-5" value="Send">
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>
</div>





@section Styles{
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="~/Admin/js/validator.min.js"></script>
    <script src="~/Admin/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/Admin/lib/tinymce/tinymce.js"></script>

    <script>
         $('.select_picker').select2();
          

        tinymce.init({
                    selector: 'textarea',
                 branding: false,
                 menubar: "edit insert format",
                 plugins: [
                "advlist autolink lists link image charmap  anchor",
                "searchreplace visualblocks",
                "  contextmenu paste imagetools wordcount"
            ],
            toolbar: "undo redo  | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image",
        });

        

    </script>

}


